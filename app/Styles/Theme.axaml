<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>

      <ResourceDictionary.ThemeDictionaries>

        <!-- dois planos: a janela e a árvore no mais escuro (BgPanel), e em cima dele os cartões um tom
             acima (Bg: o terminal, as entradas), com contorno fino. O que abre por cima de um cartão
             (menu, quadro) sobe mais um tom (BgRaised) -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Bg" Color="#14151B" />
          <SolidColorBrush x:Key="BgPanel" Color="#0F1014" />
          <SolidColorBrush x:Key="BgRaised" Color="#191B22" />
          <SolidColorBrush x:Key="BgHover" Color="#1B1D25" />
          <SolidColorBrush x:Key="BgActive" Color="#242731" />
          <SolidColorBrush x:Key="Border" Color="#282B34" />
          <SolidColorBrush x:Key="BorderSoft" Color="#1E2028" />
          <SolidColorBrush x:Key="Text" Color="#E2E5EC" />
          <SolidColorBrush x:Key="TextDim" Color="#8C93A3" />
          <SolidColorBrush x:Key="TextFaint" Color="#6A7182" />
          <!-- cores de estado: claras, para contrastar com o fundo escuro -->
          <SolidColorBrush x:Key="Accent" Color="#4F8CFF" />
          <SolidColorBrush x:Key="AccentSoft" Color="#734F8CFF" />
          <SolidColorBrush x:Key="OnAccent" Color="#08121F" />
          <SolidColorBrush x:Key="Green" Color="#3FB950" />
          <SolidColorBrush x:Key="Red" Color="#FF7B72" />
          <SolidColorBrush x:Key="Orange" Color="#F0883E" />
          <SolidColorBrush x:Key="Yellow" Color="#E3B341" />
          <SolidColorBrush x:Key="Purple" Color="#D2A8FF" />
          <SolidColorBrush x:Key="Teal" Color="#2DB3A3" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Bg" Color="#FFFFFF" />
          <SolidColorBrush x:Key="BgPanel" Color="#F2F4F7" />
          <SolidColorBrush x:Key="BgRaised" Color="#FFFFFF" />
          <SolidColorBrush x:Key="BgHover" Color="#E8EDF3" />
          <SolidColorBrush x:Key="BgActive" Color="#D7E3F7" />
          <SolidColorBrush x:Key="Border" Color="#C7D0DA" />
          <SolidColorBrush x:Key="BorderSoft" Color="#DEE4EB" />
          <SolidColorBrush x:Key="Text" Color="#14181F" />
          <SolidColorBrush x:Key="TextDim" Color="#44505F" />
          <SolidColorBrush x:Key="TextFaint" Color="#61707F" />
          <!-- as mesmas cores em tons escuros: sobre branco as claras somem -->
          <SolidColorBrush x:Key="Accent" Color="#1F6FEB" />
          <SolidColorBrush x:Key="AccentSoft" Color="#731F6FEB" />
          <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Green" Color="#17803D" />
          <SolidColorBrush x:Key="Red" Color="#C5221F" />
          <SolidColorBrush x:Key="Orange" Color="#B44B00" />
          <SolidColorBrush x:Key="Yellow" Color="#8A6100" />
          <SolidColorBrush x:Key="Purple" Color="#6A35B8" />
          <SolidColorBrush x:Key="Teal" Color="#0E7C6B" />
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>

      <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas,Courier New,monospace</FontFamily>
      <x:Double x:Key="RowHeight">26</x:Double>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- base -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Bg}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
  </Style>

  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
  </Style>

  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- botões: tudo em pílula, no padrão do GRepos, do GRemote, do GTest e do GConv. O glifo e o texto na cor
       cheia, o fundo com a cor diluída (#24) e o contorno meio diluído (#66); com o mouse em cima, o fundo fica no
       tom do contorno. A cor é uma classe, uma por tipo de ação, e o mesmo botão tem a mesma cor em todo lugar:
         azul       sessão nova, Claude sem conversa, editar, preferências
         verde      retomar, abrir o Claude, instalar
         verdeAgua  compactar
         roxo       Sessões, pull request
         laranja    Projetos, code review, corrigir
         amarelo    pedido, grupos, favoritar
         vermelho   encerrar o Claude, excluir, remover
         cinza      sem skill, cor, Painel, Terminal, cancelar, fechar (é o botão sem classe)
       Tamanhos: o comum (28), "pilula" (24: a do GTerm desde sempre, e o cabeçalho do cartão do terminal, com
       ela, fica com os 32 da pesquisa) e "pequena" (22); "redonda" é só o ícone, numa bolinha. As classes
       antigas continuam valendo: tiny = pequena, primary = azul (em negrito), danger = vermelho. No cabeçalho
       do cartão as pílulas são "quieta" (na janela principal): só o ícone na cor até o mouse chegar -->
  <Style Selector="Button">
    <Setter Property="Background" Value="#246B7280" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderBrush" Value="#666B7280" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Height" Value="28" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter, Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{Binding $parent[Button].BorderBrush}" />
    <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <!-- Só o conteúdo DIRETO do botão (o ">"): o menu e a paleta que o botão abre são descendentes lógicos dele,
       e com o seletor de descendente o que estava dentro deles pegava a cor do botão (EV03 do GRemote) -->
  <Style Selector="Button > TextBlock, Button > StackPanel.comIcone > TextBlock">
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.pilula">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="10,0,11,0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Button.pequena, Button.tiny">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Button.pequena > StackPanel.comIcone, Button.tiny > StackPanel.comIcone">
    <Setter Property="Spacing" Value="5" />
  </Style>

  <!-- só o ícone, numa bolinha do tamanho da altura -->
  <Style Selector="Button.redonda">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Button.redonda.pequena, Button.redonda.tiny">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="11" />
  </Style>
  <Style Selector="Button.redonda > TextBlock.glifo">
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- o glifo é do mesmo tamanho em todas as pílulas e no botão principal; menor na pequena -->
  <Style Selector="Button > TextBlock.glifo, Button > StackPanel.comIcone > TextBlock.glifo">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.pequena > TextBlock.glifo, Button.pequena > StackPanel.comIcone > TextBlock.glifo">
    <Setter Property="FontSize" Value="10.5" />
  </Style>

  <!-- as cores: Foreground do tema, fundo #24 e contorno #66 da paleta do GTerm -->
  <Style Selector="Button.azul, Button.primary">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="#242F7BE8" />
    <Setter Property="BorderBrush" Value="#662F7BE8" />
  </Style>
  <Style Selector="Button.verde">
    <Setter Property="Foreground" Value="{DynamicResource Green}" />
    <Setter Property="Background" Value="#241F9D55" />
    <Setter Property="BorderBrush" Value="#661F9D55" />
  </Style>
  <Style Selector="Button.verdeAgua">
    <Setter Property="Foreground" Value="{DynamicResource Teal}" />
    <Setter Property="Background" Value="#240E9384" />
    <Setter Property="BorderBrush" Value="#660E9384" />
  </Style>
  <Style Selector="Button.roxo">
    <Setter Property="Foreground" Value="{DynamicResource Purple}" />
    <Setter Property="Background" Value="#248B5CF6" />
    <Setter Property="BorderBrush" Value="#668B5CF6" />
  </Style>
  <Style Selector="Button.laranja">
    <Setter Property="Foreground" Value="{DynamicResource Orange}" />
    <Setter Property="Background" Value="#24E07B00" />
    <Setter Property="BorderBrush" Value="#66E07B00" />
  </Style>
  <Style Selector="Button.amarelo">
    <Setter Property="Foreground" Value="{DynamicResource Yellow}" />
    <Setter Property="Background" Value="#24B08500" />
    <Setter Property="BorderBrush" Value="#66B08500" />
  </Style>
  <Style Selector="Button.vermelho, Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource Red}" />
    <Setter Property="Background" Value="#24D93F3F" />
    <Setter Property="BorderBrush" Value="#66D93F3F" />
  </Style>
  <Style Selector="Button.cinza">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="Background" Value="#246B7280" />
    <Setter Property="BorderBrush" Value="#666B7280" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- a pílula ligada (o Painel e o Terminal abertos): contorno e texto na cor de destaque -->
  <Style Selector="Button.destacado">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="#662F7BE8" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <!-- botão só com um símbolo, sem pílula: a estrela da linha da árvore, que marca e desmarca -->
  <Style Selector="Button.simbolo">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons,Segoe MDL2 Assets" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.simbolo:pointerover /template/ ContentPresenter, Button.simbolo:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- amostra de cor (a paleta dos grupos): o fundo é a cor dela, também com o mouse em cima -->
  <Style Selector="Button.amostra:pointerover /template/ ContentPresenter, Button.amostra:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
  </Style>

  <!-- desligado (sem o que fazer): pílula cinza e texto apagado, qualquer que seja a cor. Fica depois das cores,
       senão elas vencem; só baixar a opacidade deixava a pílula com cara de clicável (o Commit do GRepos) -->
  <Style Selector="Button:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="#146B7280" />
    <Setter Property="BorderBrush" Value="#406B7280" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextFaint}" />
  </Style>
  <Style Selector="Button:disabled > TextBlock, Button:disabled > StackPanel.comIcone > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.8" />
  </Style>

  <!-- entradas -->

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="9,4" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Bg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
  </Style>

  <!-- listas -->

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgActive}" />
  </Style>

  <!-- containers -->

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource BgPanel}" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource BgRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <!-- Barra de rolagem fina e sem setas. A barra permanente do tema Fluent traz
       setinhas nas pontas e um fundo próprio que, ao rolar, piscam como sujeira no
       canto. Aqui sobra o indicador: largura fixa, fundo transparente e cantos
       arredondados. A largura fixa é o que mantém o espaço reservado no layout. -->
  <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ScrollBar /template/ RepeatButton#PART_LineDownButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="9" />
    <Setter Property="MinWidth" Value="9" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="9" />
    <Setter Property="MinHeight" Value="9" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ScrollBar /template/ Border">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource Border}" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <Style Selector="ScrollBar:pointerover /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource TextFaint}" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="5,0" />
  </Style>


  <!-- glifo do Segoe Fluent Icons, nos botões, na árvore e nos menus; as classes de cor servem para ele também -->
  <Style Selector="TextBlock.glifo">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons,Segoe MDL2 Assets" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>
  <Style Selector="TextBlock.azul"><Setter Property="Foreground" Value="{DynamicResource Accent}" /></Style>
  <Style Selector="TextBlock.verde"><Setter Property="Foreground" Value="{DynamicResource Green}" /></Style>
  <Style Selector="TextBlock.verdeAgua"><Setter Property="Foreground" Value="{DynamicResource Teal}" /></Style>
  <Style Selector="TextBlock.roxo"><Setter Property="Foreground" Value="{DynamicResource Purple}" /></Style>
  <Style Selector="TextBlock.laranja"><Setter Property="Foreground" Value="{DynamicResource Orange}" /></Style>
  <Style Selector="TextBlock.amarelo"><Setter Property="Foreground" Value="{DynamicResource Yellow}" /></Style>
  <Style Selector="TextBlock.vermelho"><Setter Property="Foreground" Value="{DynamicResource Red}" /></Style>
  <Style Selector="TextBlock.cinza"><Setter Property="Foreground" Value="{DynamicResource TextDim}" /></Style>
  <Style Selector="StackPanel.comIcone">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="6" />
  </Style>
  <Style Selector="StackPanel.comIcone > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- menus, como os do GRepos: cartão arredondado, item em pílula e o glifo na cor da ação (ItemDeMenu) -->
  <Style Selector="MenuFlyoutPresenter, ContextMenu">
    <Setter Property="Background" Value="{DynamicResource BgRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="5" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <!-- o menu já está um tom acima do cartão: a linha do mouse sobe mais um, senão não se vê -->
  <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot, MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource BgActive}" />
  </Style>

  <Style Selector="MenuItem:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="MenuItem TextBlock.glifo">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>

  <Style Selector="MenuFlyoutPresenter Separator, ContextMenu Separator">
    <Setter Property="Background" Value="{DynamicResource BorderSoft}" />
    <Setter Property="Margin" Value="4,4" />
  </Style>

  <!-- estado do terminal, na árvore e nas abas: um anel vazado com o Claude parado no prompt; o anel
       aberto, girando, enquanto ele trabalha; cheio quando há o que ver (terminou, erro, espera por você) -->
  <Style Selector="Ellipse.estado">
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource TextFaint}" />
    <Setter Property="StrokeThickness" Value="1.5" />
  </Style>
  <Style Selector="Ellipse.estado.rodando">
    <Setter Property="Stroke" Value="{DynamicResource Yellow}" />
    <!-- em múltiplos da espessura: três quartos de volta de traço e um quarto de vão -->
    <Setter Property="StrokeDashArray" Value="11.8,3.9" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Style.Animations>
      <Animation Duration="0:0:1.1" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Ellipse.estado.concluido">
    <Setter Property="Fill" Value="{DynamicResource Green}" />
    <Setter Property="Stroke" Value="{DynamicResource Green}" />
  </Style>
  <Style Selector="Ellipse.estado.erro">
    <Setter Property="Fill" Value="{DynamicResource Red}" />
    <Setter Property="Stroke" Value="{DynamicResource Red}" />
  </Style>
  <Style Selector="Ellipse.estado.aguardando">
    <Setter Property="Fill" Value="{DynamicResource Yellow}" />
    <Setter Property="Stroke" Value="{DynamicResource Yellow}" />
    <Setter Property="StrokeDashArray" Value="{x:Null}" />
    <Style.Animations>
      <Animation Duration="0:0:0.6" IterationCount="INFINITE" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.15" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

</Styles>