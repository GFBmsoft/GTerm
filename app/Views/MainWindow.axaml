<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:term="using:AvaloniaTerminal"
        xmlns:vm="using:GTerm.ViewModels"
        xmlns:c="using:GTerm.Controls"
        x:Class="GTerm.Views.MainWindow"
        Title="{Binding Titulo}" Width="1200" Height="720" MinWidth="640" MinHeight="360"
        Icon="/Assets/app.ico" Background="{DynamicResource BgPanel}"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <!-- árvore no padrão do GTest: linha discreta de cantos suaves, que só ganha fundo ao
         passar o mouse e quando é a selecionada. A linha da lista em si fica sem fundo -->
    <Style Selector="ListBox#Lista ListBoxItem">
      <!-- título de grupo não é escolhido nem recebe o foco: o clique abre e fecha, e as
           setas do teclado passam direto -->
      <Setter Property="Focusable" Value="{Binding Selecionavel}" />
    </Style>
    <Style Selector="ListBox#Lista ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#Lista ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- a versão no rodapé é pílula como as outras: azul, a cor do Atualizar do GRepos, e verde
         (instalar) quando há uma mais nova. Procurando ou baixando ela não aceita clique, mas o
         texto é o andamento: fica na cor, como o Code review rodando -->
    <Style Selector="Button.rodape:disabled">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.rodape:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
      <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
    </Style>
    <Style Selector="Button.rodape:disabled > StackPanel.comIcone > TextBlock">
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>

    <Style Selector="Button.grupo">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,0,8,0" />
      <Setter Property="Margin" Value="6,4,6,0" />
      <Setter Property="Height" Value="26" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- o título do grupo é uma linha da árvore, não uma pílula: só acende o fundo -->
    <Style Selector="Button.grupo:pointerover /template/ ContentPresenter, Button.grupo:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BgHover}" />
    </Style>

    <!-- abas dos abertos, em ficha de canto suave (a pílula é do botão): a da frente ganha fundo
         e contorno na cor do projeto, a mesma da moldura do cartão embaixo dela; as outras ficam
         com o contorno neutro, o ponto da cor e o nome apagado -->
    <Style Selector="Button.aba">
      <!-- a altura da pílula: com os 28 do botão comum, a faixa das abas crescia ao abrir a
           primeira, e a árvore e o terminal desciam junto -->
      <Setter Property="Height" Value="24" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style Selector="Button.aba:pointerover /template/ ContentPresenter, Button.aba:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BgHover}" />
    </Style>
    <Style Selector="TextBlock.aba">
      <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    </Style>
    <Style Selector="TextBlock.aba.frente">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- terminou ou espera por você sem estar à vista: o nome se destaca até ser visto -->
    <Style Selector="TextBlock.atencao">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Yellow}" />
    </Style>

    <Style Selector="Border.linha">
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- os cartões em cima do plano da janela: o terminal, o segundo terminal e o painel, cada um
         com o contorno fino e, os dois últimos, um cabeçalho que diz o que são -->
    <Style Selector="Border.cartao">
      <Setter Property="Background" Value="{DynamicResource Bg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.cabecalho">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.cabecalho TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- a conversa tem duas linhas: o título e, embaixo, de onde e quando -->
    <Style Selector="Border.linha.sessao">
      <Setter Property="Height" Value="38" />
    </Style>

    <!-- arrastando na árvore: um traço diz onde a linha vai cair, e o título do grupo que
         recebe fica aceso -->
    <Style Selector="Border.linha.antes">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="0,2,0,0" />
    </Style>
    <Style Selector="Border.linha.depois">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="Button.grupo.alvo /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BgActive}" />
    </Style>
    <Style Selector="Ellipse.estado.aberta">
      <Setter Property="Fill" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.linha">
      <Setter Property="Background" Value="{DynamicResource BgHover}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.linha">
      <Setter Property="Background" Value="{DynamicResource BgActive}" />
    </Style>

    <!-- a estrela e o ▶ de cada projeto só aparecem na linha do mouse e na escolhida: com
         dezenas de projetos, um em cada linha vira ruído. Escondidos, guardam o lugar, e o
         nome não pula ao passar o mouse -->
    <Style Selector="Button.acao">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Button.acao">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:selected Button.acao">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.estrela">
      <Setter Property="Width" Value="20" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <!-- a cheia fica sempre à vista, em qualquer grupo, e na cor do grupo Favoritos, também
         com o mouse em cima. Vem depois do Button.acao para valer sobre ele -->
    <Style Selector="Button.estrela.favorito">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Yellow}" />
    </Style>

    <!-- no cabeçalho do cartão do terminal as pílulas ficam quietas: são nove, cada uma na sua cor, e
         acesas todas brigavam com o terminal. Parada, só o ícone na cor e o nome apagado, como a
         escolha apagada de Projetos/Sessões; com o mouse em cima, a pílula inteira. Desligada, tudo
         apagado. Vem antes do Code review rodando, que continua aceso: é onde está o andamento -->
    <Style Selector="Button.quieta">
      <Setter Property="Padding" Value="8,0,9,0" />
    </Style>
    <Style Selector="Button.quieta /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.quieta:pointerover /template/ ContentPresenter, Button.quieta:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
      <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
    </Style>
    <Style Selector="Button.quieta > StackPanel.comIcone > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    </Style>
    <Style Selector="Button.quieta:pointerover > StackPanel.comIcone > TextBlock">
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="Button.quieta > StackPanel.comIcone > TextBlock.glifo">
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="Button.quieta:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.quieta:disabled > StackPanel.comIcone > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    </Style>
    <!-- apertados, os botões do cabeçalho ficam só com o ícone, e a dica diz o que cada um faz. O
         Code review rodando mantém o texto: é o andamento -->
    <Style Selector="StackPanel.apertada > Button > StackPanel.comIcone > TextBlock:not(.glifo)">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="StackPanel.apertada > Button.revisando > StackPanel.comIcone > TextBlock">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- à espera (o Compactar, com o Claude ocupado), a pílula fica cinza como qualquer desligada.
         O Code review rodando também não aceita clique, mas o texto dele é o status: fica na cor -->
    <Style Selector="Button.revisando:disabled">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.revisando:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
      <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
    </Style>
    <Style Selector="Button.revisando:disabled > StackPanel.comIcone > TextBlock">
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>

    <!-- o projeto já passou por code review, na árvore e no quadro: verde em dia, amarelo com
         commit ou alteração que a revisão não viu -->
    <Style Selector="TextBlock.marcaDeRevisao">
      <Setter Property="Foreground" Value="{DynamicResource Green}" />
    </Style>
    <Style Selector="TextBlock.marcaDeRevisao.desatualizada">
      <Setter Property="Foreground" Value="{DynamicResource Yellow}" />
    </Style>

    <!-- a barra do code review, em linha como a do GConv: azul trabalhando, verde no fim -->
    <Style Selector="ProgressBar.revisao">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="ProgressBar.revisao.concluida">
      <Setter Property="Foreground" Value="{DynamicResource Green}" />
    </Style>
    <Style Selector="ProgressBar.revisao.parada">
      <Setter Property="Foreground" Value="{DynamicResource Red}" />
    </Style>

    <!-- os medidores do cartão do consumo (o contexto, as janelas do plano): verde, amarelo quando
         merece atenção, vermelho perto do fim -->
    <Style Selector="ProgressBar.medidor">
      <Setter Property="Height" Value="6" />
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="{DynamicResource BgActive}" />
      <Setter Property="Foreground" Value="{DynamicResource Green}" />
    </Style>
    <Style Selector="ProgressBar.medidor.alerta">
      <Setter Property="Foreground" Value="{DynamicResource Yellow}" />
    </Style>
    <Style Selector="ProgressBar.medidor.critico">
      <Setter Property="Foreground" Value="{DynamicResource Red}" />
    </Style>
    <!-- as linhas do cartão do consumo: o quadradinho da cor da série, o nome, e os números à direita -->
    <Style Selector="Grid.tokens > Border">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.tokens > TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.numero">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style Selector="TextBlock.total">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Projetos e Sessões são uma escolha, como as abas: a escolhida é a pílula colorida
         inteira; a outra fica com o ícone na cor e o nome apagado, e acende com o mouse em
         cima. O glifo vem por último para ficar na cor também com o mouse em cima -->
    <Style Selector="Button.apagada /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    </Style>
    <Style Selector="Button.apagada:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
      <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
    </Style>
    <Style Selector="Button.apagada > StackPanel.comIcone > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    </Style>
    <Style Selector="Button.apagada:pointerover > StackPanel.comIcone > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="Button.apagada > StackPanel.comIcone > TextBlock.glifo">
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>

    <!-- o botão principal (retomar, no projeto parado e na conversa): a pílula verde de 28, em negrito -->
    <Style Selector="Button.principal">
      <Setter Property="Padding" Value="16,0,18,0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- os glifos do cia: da Nerd Font do terminal -->
    <Style Selector="TextBlock.nerd">
      <Setter Property="FontFamily" Value="CaskaydiaCove NFM,CaskaydiaMono Nerd Font,JetBrainsMono NFM,Symbols Nerd Font Mono" />
    </Style>

    <!-- o quadro do projeto parado, com o que o dashboard do cia mostra ao lado da lista:
         uma linha por item, o glifo na frente e, embaixo, o detalhe apagado -->
    <Style Selector="Border.quadro">
      <Setter Property="Background" Value="{DynamicResource BgRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style Selector="Border.quadro TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.quadro TextBlock.detalhe">
      <Setter Property="Margin" Value="22,0,0,0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    </Style>
  </Window.Styles>

  <!-- a faixa de cima é a das abas; embaixo dela começam a árvore e o terminal, e a
       pesquisa fica na mesma altura do cartão do terminal -->
  <Grid ColumnDefinitions="240,*" RowDefinitions="Auto,*">

    <!-- a árvore é um plano só, de cima a baixo, no tom da janela: um fio a separa dos cartões -->
    <Border Grid.RowSpan="2" Grid.Column="0" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,1,0"
            IsHitTestVisible="False" />

    <!-- na faixa das abas, em cima da árvore: os projetos do cia ou as conversas do Claude
         (o cl), e no modo das conversas o Claude sem nenhuma delas, no azul do Claude sem
         conversa do quadro -->
    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="10,8,9,8" Spacing="6">
      <Button Classes="pilula laranja" Classes.apagada="{Binding ModoSessoes}" Command="{Binding VerProjetosCommand}"
              ToolTip.Tip="Os projetos das pastas do cia, como no dashboard dele">
        <StackPanel Classes="comIcone">
          <TextBlock Classes="glifo" Text="{x:Static c:Glifos.Projetos}" />
          <TextBlock Text="Projetos" />
        </StackPanel>
      </Button>
      <Button Classes="pilula roxo" Classes.apagada="{Binding !ModoSessoes}" Command="{Binding VerSessoesCommand}"
              ToolTip.Tip="As conversas do Claude de todas as pastas, como o cl: retomar, favoritar e procurar pelo título">
        <StackPanel Classes="comIcone">
          <TextBlock Classes="glifo" Text="{x:Static c:Glifos.Sessoes}" />
          <TextBlock Text="Sessões" />
        </StackPanel>
      </Button>
      <Button Classes="pilula redonda azul" Command="{Binding NovaConversaCommand}" IsVisible="{Binding ModoSessoes}"
              ToolTip.Tip="Claude sem nenhuma das conversas: limpo, sem skill, na sua pasta pessoal, numa aba Claude">
        <TextBlock Classes="glifo" Text="{x:Static c:Glifos.SessaoNova}" HorizontalAlignment="Center" />
      </Button>
    </StackPanel>

    <!-- árvore dos projetos do cia, sem botão de fechar. Encerrar só pelo menu de contexto,
         e sempre com confirmação. O menu de cada linha é montado na hora do clique direito
         (MainWindow.MenuDe): o "Mover para" depende dos grupos daquele momento -->
    <Border Grid.Row="1" Grid.Column="0">
      <Grid RowDefinitions="Auto,*,Auto">

        <!-- a pesquisa tem a altura do cabeçalho do cartão do terminal, ao lado dela -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10,0,9,6">
          <TextBox x:Name="CaixaDoFiltro" Text="{Binding Filtro}" Watermark="{Binding MarcaDoFiltro}"
                   MinHeight="32" VerticalContentAlignment="Center" BorderBrush="{DynamicResource BorderSoft}"
                   ToolTip.Tip="Filtra a lista (Ctrl+Shift+P): os projetos pelo nome, as conversas pelo título ou pelo projeto. Enter vai ao primeiro, Esc limpa" />
          <Button Grid.Column="1" Classes="pilula redonda amarelo" Margin="6,0,0,0" Command="{Binding NovoGrupoCommand}"
                  ToolTip.Tip="Novo grupo. Clique direito num grupo cria um subgrupo, e arrastar leva projetos e conversas para ele">
            <TextBlock Classes="glifo" Text="{x:Static c:Glifos.NovaPasta}" HorizontalAlignment="Center" />
          </Button>
        </Grid>

        <ListBox Grid.Row="1" x:Name="Lista" ItemsSource="{Binding Linhas}"
                 SelectedItem="{Binding LinhaSelecionada}" AutoScrollToSelectedItem="False">
          <ListBox.DataTemplates>
            <!-- grupo minimalista: a seta, a contagem numa etiqueta na cor do grupo (no lugar do
                 ponto do GTest) e o nome na mesma cor -->
            <DataTemplate DataType="vm:GrupoDaArvore">
              <Button Classes="grupo" Classes.alvo="{Binding AlvoDeSoltar}" Command="{Binding AlternarCommand}">
                <Grid ColumnDefinitions="12,Auto,*" Margin="{Binding Recuo}">
                  <TextBlock Grid.Column="0" Text="{Binding Seta}" Classes="glifo faint" FontSize="8"
                             VerticalAlignment="Center" />
                  <Grid Grid.Column="1" MinWidth="18" Height="16" Margin="3,0,0,0" VerticalAlignment="Center">
                    <Border CornerRadius="5" Background="{Binding Cor}" Opacity="0.18" />
                    <TextBlock Text="{Binding Contagem}" FontSize="10" FontWeight="SemiBold" Margin="5,0"
                               Foreground="{Binding Cor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Grid.Column="2" Text="{Binding Titulo}" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0"
                             Foreground="{Binding Cor}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </DataTemplate>

            <DataTemplate DataType="vm:LinhaDoProjeto">
              <Border Classes="linha" Classes.antes="{Binding SoltarAntes}" Classes.depois="{Binding SoltarDepois}"
                      ToolTip.Tip="{Binding Projeto.Pasta}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" Margin="{Binding Recuo}">
                  <!-- o tipo do projeto, como no cia: os glifos são da Nerd Font do terminal -->
                  <TextBlock Grid.Column="0" Classes="nerd" Text="{Binding Projeto.Icone}" Foreground="{Binding Projeto.CorDoIcone}"
                             FontSize="13" Width="16" Margin="0,0,7,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Projeto.Nome}" VerticalAlignment="Center" Margin="0,0,6,0"
                             Classes.atencao="{Binding Projeto.PedeAtencao}" TextTrimming="CharacterEllipsis" />

                  <!-- já passou por code review: verde em dia, amarela com commit depois dele -->
                  <TextBlock Grid.Column="2" Classes="glifo marcaDeRevisao" Classes.desatualizada="{Binding Projeto.RevisaoDesatualizada}"
                             Text="{x:Static c:Glifos.Confirmar}" IsVisible="{Binding Projeto.TemRevisaoAnterior}" FontSize="10" Margin="0,0,6,0"
                             VerticalAlignment="Center" ToolTip.Tip="{Binding Projeto.DicaDaMarcaDeRevisao}" />

                  <TextBlock Grid.Column="3" Text="{Binding Extra}" IsVisible="{Binding TemExtra}" Classes="faint"
                             FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0" />

                  <!-- favoritar sem abrir o menu: o projeto entra no fim dos favoritos, ou sai.
                       Lá, arrastar a linha muda a ordem -->
                  <Button Grid.Column="4" Classes="pequena simbolo acao estrela" Classes.favorito="{Binding Projeto.Favorito}"
                          Content="{Binding Projeto.GlifoDoFavorito}" Command="{Binding Projeto.FavoritarCommand}"
                          ToolTip.Tip="{Binding Projeto.RotuloDoFavorito}" />

                  <!-- sem terminal: nada roda no projeto até o clique aqui (ou Enter, ou duplo clique).
                       A bolinha verde do Retomar, como na barra da aba -->
                  <Button Grid.Column="5" Classes="redonda pequena verde acao" Margin="0,0,2,0"
                          Command="{Binding Projeto.IniciarCommand}" IsVisible="{Binding Projeto.Parado}"
                          ToolTip.Tip="Abrir o Claude neste projeto">
                    <TextBlock Classes="glifo" Text="{x:Static c:Glifos.Retomar}" />
                  </Button>

                  <!-- apagado no prompt; amarelo rodando (piscando se espera por você); verde
                       ao terminar bem; vermelho ao terminar com erro -->
                  <Ellipse Grid.Column="6" Classes="estado" IsVisible="{Binding Projeto.Vivo}"
                           Classes.rodando="{Binding Projeto.Rodando}" Classes.aguardando="{Binding Projeto.Aguardando}"
                           Classes.concluido="{Binding Projeto.Concluido}" Classes.erro="{Binding Projeto.Erro}" />
                </Grid>
              </Border>
            </DataTemplate>

            <!-- uma conversa do Claude, como uma linha do cl: o título, e embaixo o projeto e
                 quando. A estrela e o ▶ como nos projetos; o ponto azul é a conversa aberta -->
            <DataTemplate DataType="vm:LinhaDaSessao">
              <Border Classes="linha sessao" Classes.antes="{Binding SoltarAntes}" Classes.depois="{Binding SoltarDepois}"
                      ToolTip.Tip="{Binding Dica}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="{Binding Recuo}">
                  <TextBlock Grid.Column="0" Classes="nerd" Text="{Binding Icone}" Foreground="{Binding CorDoIcone}"
                             FontSize="13" Width="16" Margin="0,0,7,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="0,0,6,0">
                    <TextBlock Text="{Binding Titulo}" FontSize="12" />
                    <TextBlock Text="{Binding Detalhe}" Classes="faint" FontSize="10.5" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="pequena simbolo acao estrela" Classes.favorito="{Binding Favorita}"
                          Content="{Binding GlifoDaEstrela}" Command="{Binding FavoritarCommand}"
                          ToolTip.Tip="{Binding RotuloDaEstrela}" />
                  <Button Grid.Column="3" Classes="redonda pequena verde acao" Margin="0,0,2,0"
                          Command="{Binding RetomarCommand}" ToolTip.Tip="{Binding RotuloDeRetomar}">
                    <TextBlock Classes="glifo" Text="{x:Static c:Glifos.Retomar}" />
                  </Button>
                  <Ellipse Grid.Column="4" Classes="estado aberta" IsVisible="{Binding Aberta}"
                           ToolTip.Tip="{Binding TextoDaAbertura}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>

        <!-- a versão em uso, que vira o convite quando há uma mais nova (um clique procura e
             pergunta se instala), e ao lado dela as preferências, no azul do ícone do app -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="10,8,9,9">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="BotaoDoRodape" Classes="pilula rodape" Classes.azul="{Binding !TemAtualizacao}"
                  Classes.verde="{Binding TemAtualizacao}" Command="{Binding AtualizacaoCommand}"
                  ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding DicaDoRodape}">
            <!-- o teto é do texto: dentro do StackPanel ele não encurta sozinho, e a mensagem de
                 erro inteira fica na dica -->
            <StackPanel Classes="comIcone">
              <TextBlock Classes="glifo" Text="{x:Static c:Glifos.Atualizar}" />
              <TextBlock Text="{Binding Rodape}" MaxWidth="160" />
            </StackPanel>
          </Button>
          <Button Classes="redonda azul" Margin="6,0,0,0" Command="{Binding AbrirPreferenciasCommand}"
                  ToolTip.Tip="Preferências: fonte e tamanho do terminal, contas do Claude">
            <TextBlock Classes="glifo" Text="{x:Static c:Glifos.Ajustes}" />
          </Button>
        </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- uma aba por projeto com o Claude aberto, na ordem em que foram abertos (Ctrl+Tab
         passa por elas). Sem botão de fechar: encerrar só pela barra embaixo, e com
         confirmação -->
    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto,Auto,Auto" Margin="10,8,10,8" MinHeight="24">
      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="Abas" ItemsSource="{Binding Abertos}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="aba" Command="{Binding MostrarCommand}" ToolTip.Tip="{Binding Pasta}">
                <Panel>
                  <!-- o contorno neutro das que não estão à frente -->
                  <Border CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource Border}"
                          IsVisible="{Binding !AVista}" />
                  <Border CornerRadius="7" Height="24" Padding="10,0" BorderThickness="1"
                          Background="{Binding FundoDaAba}" BorderBrush="{Binding BordaDaAba}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Ellipse Width="8" Height="8" Fill="{Binding Cor}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Nome}" FontSize="12" VerticalAlignment="Center" Classes="aba"
                                 Classes.frente="{Binding AVista}" Classes.atencao="{Binding PedeAtencao}" />
                      <!-- o estado do Claude, como na árvore -->
                      <Ellipse Classes="estado" Margin="1,0,0,0" IsVisible="{Binding Vivo}"
                               Classes.rodando="{Binding Rodando}" Classes.aguardando="{Binding Aguardando}"
                               Classes.concluido="{Binding Concluido}" Classes.erro="{Binding Erro}" />
                    </StackPanel>
                  </Border>
                </Panel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <!-- os botões do canto: pílula cinza, acesa (destacado) enquanto o que ela abre está aberto.
           O consumo é da janela: ligado, o cartão acompanha o projeto que estiver à vista -->
      <Button Grid.Column="1" x:Name="BotaoDoConsumo" Classes="pilula cinza" Classes.destacado="{Binding ConsumoLigado}"
              Margin="6,0,0,0" Command="{Binding AlternarConsumoCommand}"
              ToolTip.Tip="Abre ou fecha o cartão do consumo do Claude, ao lado do terminal: o contexto e os tokens da sessão, os limites do plano e o consumo do projeto por dia">
        <StackPanel Classes="comIcone">
          <TextBlock Classes="glifo" Text="{x:Static c:Glifos.Consumo}" />
          <TextBlock Text="Consumo" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Classes="pilula cinza" Classes.destacado="{Binding PainelVisivel}" Margin="6,0,0,0"
              Command="{Binding AlternarPainelCommand}" IsVisible="{Binding TemPainel}"
              ToolTip.Tip="Abre ou fecha o painel lateral deste projeto">
        <StackPanel Classes="comIcone">
          <TextBlock Classes="glifo" Text="{x:Static c:Glifos.Painel}" />
          <TextBlock Text="Painel" />
        </StackPanel>
      </Button>
      <Button Grid.Column="3" Classes="pilula cinza" Classes.destacado="{Binding AuxiliarVisivel}" Margin="6,0,0,0"
              Command="{Binding AlternarAuxiliarCommand}" IsVisible="{Binding PodeAuxiliar}"
              ToolTip.Tip="Abre ou fecha um segundo terminal na pasta do projeto, para rodar comandos sem interromper o Claude">
        <StackPanel Classes="comIcone">
          <TextBlock Classes="glifo" Text="{x:Static c:Glifos.Terminal}" />
          <TextBlock Text="Terminal" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- os cartões: o do terminal, e, quando abertos, o do segundo terminal embaixo dele e o do
         painel ao lado, cada um na sua moldura -->
    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto,Auto" RowDefinitions="*,Auto" Margin="10,0,10,10">

      <!-- o terminal encaixado num cartão, um tom acima da janela. O recorte arredonda também o
           conteúdo do terminal, e o contorno vai por cima (os dois Border do fim): neutro sem aba,
           na cor do projeto com a aba dele à frente -->
      <Border Grid.Row="0" Grid.Column="0" x:Name="Cartao" CornerRadius="10" ClipToBounds="True"
              Background="{DynamicResource Bg}">
      <Grid RowDefinitions="Auto,*">

      <!-- o cabeçalho do cartão: os botões da aba da frente, no tom dela. Trocar de aba troca os
           botões. São as pílulas do projeto parado, com as mesmas cores, quietas até o mouse
           chegar. Quem encerra o Claude manda o /exit antes, e tudo que o encerra confirma. O
           cabeçalho tem a altura da pesquisa, ao lado -->
      <Border Grid.Row="0" x:Name="BarraDaAba" IsVisible="{Binding TemAbaAtiva}" Height="32">
        <Grid>
        <Border DataContext="{Binding AbaAtiva}" Padding="5,0,5,0" BorderThickness="0,0,0,1"
                Background="{Binding FundoDaBarra}" BorderBrush="{Binding Fundo}">
          <Grid ColumnDefinitions="*,Auto">
            <!-- sem lugar para todos (a janela estreita, o cartão do consumo aberto), os botões ficam
                 só com o ícone: quem põe e tira o "apertada" é a janela (MainWindow.CaberBotoes).
                 O recorte é só para o que ainda assim não couber não passar por baixo do Encerrar -->
            <StackPanel x:Name="BotoesDaAba" Orientation="Horizontal" Spacing="2" ClipToBounds="True">
              <Button Classes="pilula quieta verde" Command="{Binding ContinuarCommand}"
                      ToolTip.Tip="Abre de novo continuando a última sessão, mesmo grande ou de outro dia">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static c:Glifos.Retomar}" />
                  <TextBlock Text="Retomar" />
                </StackPanel>
              </Button>
              <Button Classes="pilula quieta azul" Command="{Binding SessaoNovaCommand}"
                      ToolTip.Tip="Começa do zero, sem retomar a última sessão">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static c:Glifos.SessaoNova}" />
                  <TextBlock Text="Sessão nova" />
                </StackPanel>
              </Button>
              <Button Classes="pilula quieta amarelo" Command="{Binding PedidoCommand}" IsVisible="{Binding EhDaBmsoft}"
                      ToolTip.Tip="Sessão nova no /pedido com o número do Mantis">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static c:Glifos.Pedido}" />
                  <TextBlock Text="Pedido…" />
                </StackPanel>
              </Button>
              <Button Classes="pilula quieta roxo" Command="{Binding PullRequestCommand}" IsVisible="{Binding EhDaBmsoft}"
                      ToolTip.Tip="Sessão nova na /delphi-pr">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static c:Glifos.PullRequest}" />
                  <TextBlock Text="Pull request" />
                </StackPanel>
              </Button>
              <Button Classes="pilula quieta cinza" Command="{Binding SemSkillCommand}"
                      ToolTip.Tip="O Claude limpo, sem skill nenhuma">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static c:Glifos.SemSkill}" />
                  <TextBlock Text="Sem skill" />
                </StackPanel>
              </Button>
              <Rectangle Width="1" Height="14" Margin="4,0" Fill="{DynamicResource Border}" VerticalAlignment="Center" />

              <!-- depois do traço, o que age na aba sem abrir o Claude de novo -->
              <Button Classes="pilula quieta verdeAgua" Command="{Binding CompactarCommand}" ToolTip.ShowOnDisabled="True"
                      ToolTip.Tip="Manda o /compact ao Claude, para resumir a conversa. Disponível com ele parado, esperando um pedido">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static c:Glifos.Compactar}" />
                  <TextBlock Text="Compactar" />
                </StackPanel>
              </Button>
              <Button Classes="pilula quieta laranja" Classes.revisando="{Binding RevisaoRodando}" x:Name="CodeReview"
                      Command="{Binding RevisarCommand}" ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding DicaDaRevisao}">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static c:Glifos.Revisar}" />
                  <TextBlock Text="{Binding RotuloDaRevisao}" />
                </StackPanel>
              </Button>

              <!-- a paleta do GRepos abre aqui, montada no código da janela -->
              <Button Classes="pilula quieta cinza" x:Name="CorDaAba" ToolTip.Tip="A cor da aba deste projeto e da moldura do terminal">
                <StackPanel Classes="comIcone">
                  <Ellipse Width="8" Height="8" Fill="{Binding Cor}" VerticalAlignment="Center" />
                  <TextBlock Text="Cor" />
                </StackPanel>
              </Button>
            </StackPanel>

            <Button Grid.Column="1" x:Name="EncerrarDaAba" Classes="pilula quieta vermelho" Command="{Binding EncerrarCommand}"
                    ToolTip.Tip="Manda o /exit ao Claude e fecha a aba; o que estiver rodando é interrompido">
              <StackPanel Classes="comIcone">
                <TextBlock Classes="glifo" Text="{x:Static c:Glifos.Encerrar}" />
                <TextBlock Text="Encerrar o Claude" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- a linha do code review, na largura do cabeçalho, em cima do fio que o separa do
             terminal: entre os botões não sobra lugar na janela padrão, e aqui ela aparecer não
             mexe na altura do terminal. O percentual é estimado pelo tempo: o agente não informa
             a fase -->
        <ProgressBar x:Name="BarraDaRevisao" DataContext="{Binding AbaAtiva}" Classes="revisao"
                     Classes.concluida="{Binding RevisaoConcluida}" Classes.parada="{Binding RevisaoParada}"
                     IsVisible="{Binding TemRevisao}" Minimum="0" Maximum="100" Value="{Binding PercentualDaRevisao}"
                     Height="4" MinHeight="4" MinWidth="0" CornerRadius="2"
                     Margin="12,0,12,-2" VerticalAlignment="Bottom" IsHitTestVisible="False"
                     Background="{DynamicResource BgActive}" />
        </Grid>
      </Border>

      <Grid Grid.Row="1">

        <!-- um terminal por projeto aberto, todos vivos; só o do selecionado aparece -->
        <ItemsControl x:Name="Sessoes" ItemsSource="{Binding Sessoes}" Margin="12,9,4,9">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Grid />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <term:TerminalControl Model="{Binding Modelo}" IsVisible="{Binding Ativa}"
                                    RightClickAction="CopyOrPaste" CaretStyle="Bar"
                                    DefaultBackground="{DynamicResource Bg}" CaretBrush="{DynamicResource Text}"
                                    FontFamily="{Binding $parent[ItemsControl].DataContext.Fonte}"
                                    FontSize="{Binding $parent[ItemsControl].DataContext.TamanhoDaFonte}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- sem terminal à vista: o aviso (nenhum projeto, nenhum escolhido, erro ao abrir)
             e, no projeto parado, os jeitos de abrir o Claude pelo cia -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    MaxWidth="520" Margin="16,0">
          <TextBlock Text="{Binding Aviso}" Classes="dim" TextWrapping="Wrap" TextAlignment="Center"
                     IsVisible="{Binding Aviso, Converter={x:Static ObjectConverters.IsNotNull}}" />

          <StackPanel Spacing="10" IsVisible="{Binding MostrarParado}">
            <!-- sem aba ainda: o nome, a pasta e o tipo ficam aqui -->
            <StackPanel Spacing="2" Margin="0,0,0,4">
              <TextBlock Text="{Binding Selecionado.Nome}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <TextBlock Text="{Binding Selecionado.Pasta}" Classes="faint" FontSize="11" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Classes="nerd" Text="{Binding Selecionado.Icone}" Foreground="{Binding Selecionado.CorDoIcone}"
                             FontSize="11" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Selecionado.Tipo}" Foreground="{Binding Selecionado.CorDoIcone}" FontSize="11" />
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- o quadro do cia: o git, o CLAUDE.md, a sessão que o Enter retoma e a última
                 vez que o projeto foi aberto -->
            <Border Classes="quadro" MinWidth="360" MaxWidth="460" Margin="0,0,0,6">
              <StackPanel Spacing="4">
                <TextBlock Text="carregando…" Classes="faint" IsVisible="{Binding !Selecionado.GitLido}" />

                <Grid ColumnDefinitions="22,*" IsVisible="{Binding Selecionado.SemGit}">
                  <TextBlock Classes="nerd faint" Text="&#xE725;" />
                  <TextBlock Grid.Column="1" Classes="faint" Text="sem git" />
                </Grid>

                <StackPanel Spacing="1" IsVisible="{Binding Selecionado.GitRecusou}">
                  <Grid ColumnDefinitions="22,*">
                    <TextBlock Text="!" FontWeight="Bold" Foreground="{DynamicResource Yellow}" />
                    <TextBlock Grid.Column="1" Text="o git recusou o repositório" Foreground="{DynamicResource Yellow}" />
                  </Grid>
                  <TextBlock Classes="detalhe" Text="provável dubious ownership (safe.directory)" />
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding Selecionado.ComGit}">
                  <Grid ColumnDefinitions="22,Auto,*">
                    <TextBlock Classes="nerd" Text="&#xE725;" Foreground="{DynamicResource Purple}" />
                    <TextBlock Grid.Column="1" Text="{Binding Selecionado.Git.Branch}" />
                    <TextBlock Grid.Column="2" Text="{Binding Selecionado.AFrenteAtras}" Margin="10,0,0,0"
                               Foreground="{DynamicResource Accent}" />
                  </Grid>
                  <Grid ColumnDefinitions="22,*" IsVisible="{Binding Selecionado.Limpo}">
                    <TextBlock Classes="nerd" Text="&#xF00C;" Foreground="{DynamicResource Green}" />
                    <TextBlock Grid.Column="1" Text="limpo" Foreground="{DynamicResource Green}" />
                  </Grid>
                  <Grid ColumnDefinitions="22,*" IsVisible="{Binding Selecionado.Alterado}">
                    <TextBlock Text="●" Foreground="{DynamicResource Yellow}" />
                    <TextBlock Grid.Column="1" Text="{Binding Selecionado.TextoDasAlteracoes}"
                               Foreground="{DynamicResource Yellow}" />
                  </Grid>
                  <StackPanel Spacing="1" IsVisible="{Binding Selecionado.TemCommit}">
                    <Grid ColumnDefinitions="22,*">
                      <TextBlock Classes="nerd faint" Text="&#xE729;" />
                      <TextBlock Grid.Column="1" Text="{Binding Selecionado.TextoDoCommit}" />
                    </Grid>
                    <TextBlock Classes="detalhe" Text="{Binding Selecionado.Git.Mensagem}" />
                  </StackPanel>
                </StackPanel>

                <Grid ColumnDefinitions="22,Auto,*">
                  <TextBlock Classes="nerd faint" Text="&#xF15B;" />
                  <TextBlock Grid.Column="1" Text="CLAUDE.md" Margin="0,0,6,0" />
                  <TextBlock Grid.Column="2" Text="sim" Foreground="{DynamicResource Green}"
                             IsVisible="{Binding Selecionado.TemClaudeMd}" />
                  <TextBlock Grid.Column="2" Text="não" Classes="faint" IsVisible="{Binding !Selecionado.TemClaudeMd}" />
                </Grid>

                <!-- o último code review terminado, e se ele ainda vale para o que está aqui -->
                <StackPanel Spacing="1" IsVisible="{Binding Selecionado.TemRevisaoAnterior}">
                  <Grid ColumnDefinitions="22,Auto,*">
                    <TextBlock Classes="glifo" Text="{x:Static c:Glifos.Revisar}" FontSize="11" Foreground="{DynamicResource Orange}" />
                    <TextBlock Grid.Column="1" Text="{Binding Selecionado.TextoDaRevisaoAnterior}" />
                    <TextBlock Grid.Column="2" Classes="marcaDeRevisao" Classes.desatualizada="{Binding Selecionado.RevisaoForaDeDia}"
                               Text="{Binding Selecionado.SituacaoDaRevisao}" Margin="10,0,0,0" />
                  </Grid>
                  <TextBlock Classes="detalhe" Text="{Binding Selecionado.UltimaRevisao.Resumo}"
                             TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Spacing="1" IsVisible="{Binding Selecionado.TemSessao}">
                  <Grid ColumnDefinitions="22,Auto,*">
                    <TextBlock Classes="nerd" Text="&#xF120;" Foreground="{DynamicResource Accent}" />
                    <TextBlock Grid.Column="1" Text="{Binding Selecionado.QuandoDaSessao}" />
                    <TextBlock Grid.Column="2" Text="{Binding Selecionado.TamanhoDaSessao}" Classes="faint" Margin="10,0,0,0" />
                  </Grid>
                  <TextBlock Classes="detalhe" Text="{Binding Selecionado.UltimaSessao.Titulo}" />
                </StackPanel>

                <Grid ColumnDefinitions="22,Auto,*" IsVisible="{Binding Selecionado.TemAbertura}">
                  <TextBlock Classes="nerd faint" Text="&#xF017;" />
                  <TextBlock Grid.Column="1" Text="{Binding Selecionado.TextoDaAbertura}" />
                  <TextBlock Grid.Column="2" Text="{Binding Selecionado.DetalheDaAbertura}" Classes="faint" />
                </Grid>
              </StackPanel>
            </Border>

            <Button Classes="verde principal" HorizontalAlignment="Center"
                    Command="{Binding Selecionado.IniciarCommand}"
                    ToolTip.Tip="{x:Static vm:ProjetoViewModel.DicaDeAbrir}">
              <StackPanel Classes="comIcone" Spacing="8">
                <TextBlock Classes="glifo" Text="{x:Static c:Glifos.Retomar}" />
                <TextBlock Text="{Binding Selecionado.RotuloDeAbrir}" />
              </StackPanel>
            </Button>
            <TextBlock Text="{Binding Selecionado.TextoDaSessao}" Classes="faint" FontSize="11.5"
                       IsVisible="{Binding Selecionado.TemTextoDaSessao}"
                       TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            <!-- os outros jeitos de abrir, em pílula colorida como as do GTest: fundo diluído
                 e contorno na cor de cada um -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
              <Button Classes="pilula verde" Command="{Binding Selecionado.ContinuarCommand}"
                      IsVisible="{Binding Selecionado.PodeContinuar}"
                      ToolTip.Tip="Retoma a última sessão mesmo assim, como o cia -Continuar">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static c:Glifos.Retomar}" />
                  <TextBlock Text="Continuar a última" />
                </StackPanel>
              </Button>
              <Button Classes="pilula azul" Command="{Binding Selecionado.SessaoNovaCommand}"
                      ToolTip.Tip="Começa do zero, sem retomar a última sessão">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static c:Glifos.SessaoNova}" />
                  <TextBlock Text="Sessão nova" />
                </StackPanel>
              </Button>
              <Button Classes="pilula amarelo" Command="{Binding Selecionado.PedidoCommand}"
                      IsVisible="{Binding Selecionado.EhDaBmsoft}"
                      ToolTip.Tip="Sessão nova no /pedido com o número do Mantis">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static c:Glifos.Pedido}" />
                  <TextBlock Text="Pedido…" />
                </StackPanel>
              </Button>
              <Button Classes="pilula roxo" Command="{Binding Selecionado.PullRequestCommand}"
                      IsVisible="{Binding Selecionado.EhDaBmsoft}"
                      ToolTip.Tip="Sessão nova na /delphi-pr">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static c:Glifos.PullRequest}" />
                  <TextBlock Text="Pull request" />
                </StackPanel>
              </Button>
              <Button Classes="pilula cinza" Command="{Binding Selecionado.SemSkillCommand}"
                      ToolTip.Tip="O Claude limpo, sem skill nenhuma">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static c:Glifos.SemSkill}" />
                  <TextBlock Text="Sem skill" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>

          <!-- a conversa escolhida no modo Sessões, no mesmo quadro do projeto parado: o que o
               cl mostra numa linha, e retomar ou favoritar -->
          <StackPanel Spacing="10" IsVisible="{Binding MostrarSessao}">
            <StackPanel Spacing="3" Margin="0,0,0,4">
              <TextBlock Text="{Binding SessaoAVista.Titulo}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                         TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Classes="nerd" Text="{Binding SessaoAVista.Icone}" Foreground="{Binding SessaoAVista.CorDoIcone}"
                             FontSize="11" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding SessaoAVista.Projeto}" Foreground="{Binding SessaoAVista.CorDoIcone}" FontSize="11" />
                </StackPanel>
                <TextBlock Text="{Binding SessaoAVista.Sessao.Pasta}" Classes="faint" FontSize="11" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>

            <Border Classes="quadro" MinWidth="360" MaxWidth="460" Margin="0,0,0,6">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="22,*" IsVisible="{Binding SessaoAVista.TemBranch}">
                  <TextBlock Classes="nerd" Text="&#xE725;" Foreground="{DynamicResource Purple}" />
                  <TextBlock Grid.Column="1" Text="{Binding SessaoAVista.Sessao.Branch}" />
                </Grid>
                <Grid ColumnDefinitions="22,Auto,*">
                  <TextBlock Classes="nerd" Text="&#xF120;" Foreground="{DynamicResource Accent}" />
                  <TextBlock Grid.Column="1" Text="{Binding SessaoAVista.Quando}" />
                  <TextBlock Grid.Column="2" Text="{Binding SessaoAVista.Tamanho}" Classes="faint" Margin="10,0,0,0" />
                </Grid>
                <Grid ColumnDefinitions="22,*" IsVisible="{Binding SessaoAVista.Aberta}">
                  <TextBlock Text="●" Foreground="{DynamicResource Accent}" />
                  <TextBlock Grid.Column="1" Text="{Binding SessaoAVista.TextoDaAbertura}" Foreground="{DynamicResource Accent}" />
                </Grid>
                <Grid ColumnDefinitions="22,*" IsVisible="{Binding SessaoAVista.Sessao.Bg}">
                  <TextBlock Classes="glifo" Text="{x:Static c:Glifos.SegundoPlano}" FontSize="11" Foreground="{DynamicResource Purple}" />
                  <TextBlock Grid.Column="1" Text="com um job em segundo plano" Foreground="{DynamicResource Purple}" />
                </Grid>
                <Grid ColumnDefinitions="22,*">
                  <TextBlock Classes="nerd faint" Text="&#xF292;" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding SessaoAVista.Sessao.Id}" Classes="faint" FontSize="11.5"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}" />
                </Grid>
              </StackPanel>
            </Border>

            <Button Classes="verde principal" HorizontalAlignment="Center"
                    Command="{Binding SessaoAVista.RetomarCommand}"
                    ToolTip.Tip="Abre o Claude na pasta da conversa, na aba do projeto, com o --resume dela, como o cl">
              <StackPanel Classes="comIcone" Spacing="8">
                <TextBlock Classes="glifo" Text="{x:Static c:Glifos.Retomar}" />
                <TextBlock Text="{Binding SessaoAVista.RotuloDeRetomar}" />
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
              <Button Classes="pilula amarelo" Command="{Binding SessaoAVista.FavoritarCommand}"
                      ToolTip.Tip="As favoritas ficam em cima, em qualquer pasta, e são as mesmas do cl">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{Binding SessaoAVista.GlifoDaEstrela}" />
                  <TextBlock Text="{Binding SessaoAVista.RotuloDaEstrela}" />
                </StackPanel>
              </Button>
              <Button Classes="pilula azul" Command="{Binding NovaConversaCommand}"
                      ToolTip.Tip="Claude sem nenhuma das conversas: limpo, sem skill, na sua pasta pessoal, numa aba Claude">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static c:Glifos.SessaoNova}" />
                  <TextBlock Text="Claude sem conversa" />
                </StackPanel>
              </Button>
              <Button Classes="pilula vermelho" Command="{Binding SessaoAVista.ExcluirCommand}" ToolTip.ShowOnDisabled="True"
                      ToolTip.Tip="Manda a conversa para a Lixeira do Windows: ela some daqui, do /resume e do cl. Aberta, só depois de fechar">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static c:Glifos.Excluir}" />
                  <TextBlock Text="{Binding SessaoAVista.RotuloDeExcluir}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- o contorno do cartão, por cima de tudo e sem ocupar lugar: com uma aba à frente, na cor
           do projeto dela, como a ficha da aba em cima -->
      <Border Grid.RowSpan="2" CornerRadius="10" BorderThickness="1" IsHitTestVisible="False"
              BorderBrush="{DynamicResource Border}" IsVisible="{Binding !TemAbaAtiva}" />
      <Border Grid.RowSpan="2" x:Name="MolduraDaAba" CornerRadius="10" BorderThickness="1" IsHitTestVisible="False"
              BorderBrush="{Binding AbaAtiva.BordaDaBarra}" IsVisible="{Binding TemAbaAtiva}" />
      </Grid>
      </Border>

      <!-- segundo terminal do projeto, num cartão embaixo do principal: um shell simples, para o
           build ou o git que não podem esperar o Claude terminar -->
      <Border Grid.Row="1" Grid.Column="0" Classes="cartao" Height="258" Margin="0,8,0,0"
              IsVisible="{Binding AuxiliarVisivel}">
        <Grid RowDefinitions="Auto,*">
          <Border Classes="cabecalho">
            <StackPanel Classes="comIcone" Spacing="8">
              <TextBlock Classes="glifo cinza" Text="{x:Static c:Glifos.Terminal}" />
              <TextBlock Text="Terminal" />
              <TextBlock Text="{Binding Selecionado.Pasta}" Classes="faint" FontSize="11" />
            </StackPanel>
          </Border>
          <ItemsControl Grid.Row="1" x:Name="Auxiliares" ItemsSource="{Binding Auxiliares}" Margin="12,8,4,9">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Grid />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <term:TerminalControl Model="{Binding Modelo}" IsVisible="{Binding Ativa}"
                                      RightClickAction="CopyOrPaste" CaretStyle="Bar"
                                      DefaultBackground="{DynamicResource Bg}" CaretBrush="{DynamicResource Text}"
                                      FontFamily="{Binding $parent[ItemsControl].DataContext.Fonte}"
                                      FontSize="{Binding $parent[ItemsControl].DataContext.TamanhoDaFonte}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>

      <!-- painel lateral (o consumo do Claude, por exemplo), num cartão ao lado: outro terminal,
           estreito, rodando o script das preferências na pasta e na conta do projeto -->
      <Border Grid.Column="1" Grid.RowSpan="2" Classes="cartao" Width="330" Margin="8,0,0,0"
              IsVisible="{Binding PainelVisivel}">
        <Grid RowDefinitions="Auto,*">
          <Border Classes="cabecalho">
            <StackPanel Classes="comIcone" Spacing="8">
              <TextBlock Classes="glifo cinza" Text="{x:Static c:Glifos.Painel}" />
              <TextBlock Text="Painel" />
            </StackPanel>
          </Border>
          <ItemsControl Grid.Row="1" x:Name="Paineis" ItemsSource="{Binding Paineis}" Margin="10,8,4,9">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Grid />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <term:TerminalControl Model="{Binding Modelo}" IsVisible="{Binding Ativa}"
                                      RightClickAction="CopyOrPaste" CaretStyle="Bar"
                                      DefaultBackground="{DynamicResource Bg}" CaretBrush="{DynamicResource Bg}"
                                      FontFamily="{Binding $parent[ItemsControl].DataContext.Fonte}"
                                      FontSize="{Binding $parent[ItemsControl].DataContext.TamanhoDaFonte}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>

      <!-- o consumo do Claude, num cartão ao lado do terminal: o que o ctop -Slim mostrava no painel
           lateral do cia, lido aqui dos mesmos arquivos e sem terminal nenhum. De cima para baixo, o
           contexto da conversa, os limites do plano, os tokens da sessão e o projeto dia a dia -->
      <Border Grid.Column="2" Grid.RowSpan="2" x:Name="CartaoDoConsumo" Classes="cartao" Width="286" Margin="8,0,0,0"
              IsVisible="{Binding ConsumoVisivel}">
        <Grid RowDefinitions="Auto,*" DataContext="{Binding Consumo}">
          <Border Classes="cabecalho">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Classes="comIcone" Spacing="8">
                <TextBlock Classes="glifo cinza" Text="{x:Static c:Glifos.Consumo}" />
                <TextBlock Text="Consumo" />
              </StackPanel>
              <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center" IsVisible="{Binding TemPlano}"
                      ToolTip.Tip="O plano da conta do Claude">
                <TextBlock Text="{Binding Plano}" Classes="dim" FontSize="10.5" />
              </Border>
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,12,14,14" Spacing="18">

              <!-- o contexto: o que a conversa relê a cada turno. Amarelo acima do que o cia retoma sozinho -->
              <StackPanel Spacing="6" IsVisible="{Binding TemContexto}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="sectionTitle" Text="CONTEXTO" />
                  <TextBlock Grid.Column="1" Classes="total" Text="{Binding PercentualDoContexto}" />
                </Grid>
                <ProgressBar Classes="medidor" Classes.alerta="{Binding ContextoAlto}" Classes.critico="{Binding ContextoCritico}"
                             Minimum="0" Maximum="100" Value="{Binding Contexto}"
                             ToolTip.Tip="A janela é deduzida do maior contexto que a conversa já teve: 200 mil tokens, ou 1 milhão se ela já passou disso. O Claude não a grava na conversa" />
                <TextBlock Classes="faint" FontSize="11.5" Text="{Binding TextoDoContexto}" />
                <TextBlock FontSize="11" Foreground="{DynamicResource Yellow}" TextWrapping="Wrap"
                           Text="{Binding AvisoDoContexto}" IsVisible="{Binding ContextoAlto}" />
              </StackPanel>

              <!-- os limites do plano, como o /usage: são da conta, e não mudam com o projeto -->
              <StackPanel Spacing="9">
                <TextBlock Classes="sectionTitle" Text="LIMITES DO PLANO" />
                <ItemsControl ItemsSource="{Binding Limites}" IsVisible="{Binding TemLimites}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="11" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <TextBlock Text="{Binding Nome}" FontSize="12" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Classes="faint" Text="{Binding Zera}" FontSize="11" Margin="8,0"
                                     VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="total" FontSize="12" Text="{Binding Percentual}" />
                        </Grid>
                        <ProgressBar Classes="medidor" Classes.alerta="{Binding Alerta}" Classes.critico="{Binding Critico}"
                                     Minimum="0" Maximum="100" Value="{Binding Valor}" />
                        <TextBlock Text="{Binding Bloqueio}" IsVisible="{Binding TemBloqueio}" FontSize="11"
                                   Foreground="{DynamicResource Red}" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="faint" FontSize="11" TextWrapping="Wrap" Text="{Binding AvisoDosLimites}"
                           IsVisible="{Binding TemAvisoDosLimites}" />
              </StackPanel>

              <!-- os tokens da conversa, com os subagentes dela, crus como o ctop soma -->
              <StackPanel Spacing="7">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="sectionTitle" Text="{Binding TituloDaSessao}" />
                  <TextBlock Grid.Column="1" Classes="total" Text="{Binding TotalDaSessao}" IsVisible="{Binding TemSessao}"
                             ToolTip.Tip="Tokens crus, cada tipo com peso 1. Não é a conta do /usage, que pondera pelo modelo e pelo cache" />
                </Grid>
                <TextBlock Classes="faint" FontSize="11.5" TextWrapping="Wrap" Text="{Binding SemSessao}"
                           IsVisible="{Binding !TemSessao}" />
                <StackPanel Spacing="7" IsVisible="{Binding TemSessao}">
                  <c:BarraEmpilhada Height="6" Partes="{Binding Partes}" Trilho="{DynamicResource BgActive}"
                                    Cor0="{DynamicResource Accent}" Cor1="{DynamicResource Purple}"
                                    Cor2="{DynamicResource Orange}" Cor3="{DynamicResource Teal}" />
                  <StackPanel Spacing="3">
                    <Grid Classes="tokens" ColumnDefinitions="16,*,Auto,40">
                      <Border Background="{DynamicResource Accent}" />
                      <TextBlock Grid.Column="1" Classes="dim" Text="entrada" />
                      <TextBlock Grid.Column="2" Classes="numero" Text="{Binding Entrada.Valor}" />
                      <TextBlock Grid.Column="3" Classes="numero faint" Text="{Binding Entrada.Percentual}" />
                    </Grid>
                    <Grid Classes="tokens" ColumnDefinitions="16,*,Auto,40">
                      <Border Background="{DynamicResource Purple}" />
                      <TextBlock Grid.Column="1" Classes="dim" Text="saída" />
                      <TextBlock Grid.Column="2" Classes="numero" Text="{Binding Saida.Valor}" />
                      <TextBlock Grid.Column="3" Classes="numero faint" Text="{Binding Saida.Percentual}" />
                    </Grid>
                    <Grid Classes="tokens" ColumnDefinitions="16,*,Auto,40">
                      <Border Background="{DynamicResource Orange}" />
                      <TextBlock Grid.Column="1" Classes="dim" Text="cache gravado" />
                      <TextBlock Grid.Column="2" Classes="numero" Text="{Binding CacheGravado.Valor}" />
                      <TextBlock Grid.Column="3" Classes="numero faint" Text="{Binding CacheGravado.Percentual}" />
                    </Grid>
                    <Grid Classes="tokens" ColumnDefinitions="16,*,Auto,40">
                      <Border Background="{DynamicResource Teal}" />
                      <TextBlock Grid.Column="1" Classes="dim" Text="cache lido" />
                      <TextBlock Grid.Column="2" Classes="numero" Text="{Binding CacheLido.Valor}" />
                      <TextBlock Grid.Column="3" Classes="numero faint" Text="{Binding CacheLido.Percentual}" />
                    </Grid>
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <TextBlock Classes="faint" FontSize="11" Text="{Binding ResumoDaSessao}" />
                    <TextBlock Classes="faint" FontSize="11" Text="{Binding AndamentoDaSessao}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>

              <!-- o projeto dia a dia, de todas as conversas dele: a barra de hoje é a acesa -->
              <StackPanel Spacing="7" IsVisible="{Binding TemProjeto}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="sectionTitle" Text="{Binding TituloDoProjeto}" />
                  <TextBlock Grid.Column="1" Classes="total" Text="{Binding TotalDoProjeto}" />
                </Grid>
                <c:BarrasPorDia Height="46" Valores="{Binding PorDia}" Rotulos="{Binding RotulosDosDias}"
                                Cor="{DynamicResource AccentSoft}" CorDeHoje="{DynamicResource Accent}"
                                Trilho="{DynamicResource BgActive}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="faint" FontSize="10.5" Text="{Binding PrimeiroDia}" />
                  <TextBlock Grid.Column="1" Classes="faint" FontSize="10.5" Text="hoje" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
