<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:term="using:AvaloniaTerminal"
        xmlns:vm="using:GTerm.ViewModels"
        x:Class="GTerm.Views.MainWindow"
        Title="{Binding Titulo}" Width="1200" Height="720" MinWidth="640" MinHeight="360"
        Icon="/Assets/app.ico" Background="{DynamicResource BgPanel}"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <!-- árvore no padrão do GTest: linha discreta de cantos suaves, que só ganha fundo ao
         passar o mouse e quando é a selecionada. A linha da lista em si fica sem fundo -->
    <Style Selector="ListBox#Lista ListBoxItem">
      <!-- título de grupo não é escolhido nem recebe o foco: o clique abre e fecha, e as
           setas do teclado passam direto -->
      <Setter Property="Focusable" Value="{Binding Selecionavel}" />
    </Style>
    <Style Selector="ListBox#Lista ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#Lista ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.rodape">
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    </Style>
    <Style Selector="Button.rodape.destaque">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="Button.grupo">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="6,0,8,0" />
      <Setter Property="Margin" Value="6,4,6,0" />
      <Setter Property="Height" Value="26" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- abas dos abertos: a da frente ganha fundo e contorno na cor do projeto (no Border de
         dentro); as outras ficam só com o ponto da cor e o nome apagado -->
    <Style Selector="Button.aba">
      <!-- a altura da pílula: com os 28 do botão comum, a faixa das abas crescia ao abrir a
           primeira, e a árvore e o terminal desciam junto -->
      <Setter Property="Height" Value="24" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style Selector="Button.aba:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BgHover}" />
    </Style>
    <Style Selector="TextBlock.aba">
      <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    </Style>
    <Style Selector="TextBlock.aba.frente">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- terminou ou espera por você sem estar à vista: o nome se destaca até ser visto -->
    <Style Selector="TextBlock.atencao">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Yellow}" />
    </Style>

    <Style Selector="Border.linha">
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- a conversa tem duas linhas: o título e, embaixo, de onde e quando -->
    <Style Selector="Border.linha.sessao">
      <Setter Property="Height" Value="38" />
    </Style>

    <!-- arrastando na árvore: um traço diz onde a linha vai cair, e o título do grupo que
         recebe fica aceso -->
    <Style Selector="Border.linha.antes">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="0,2,0,0" />
    </Style>
    <Style Selector="Border.linha.depois">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="Button.grupo.alvo /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BgActive}" />
    </Style>
    <Style Selector="Ellipse.estado.aberta">
      <Setter Property="Fill" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.linha">
      <Setter Property="Background" Value="{DynamicResource BgHover}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.linha">
      <Setter Property="Background" Value="{DynamicResource BgActive}" />
    </Style>

    <!-- a estrela e o ▶ de cada projeto só aparecem na linha do mouse e na escolhida: com
         dezenas de projetos, um em cada linha vira ruído. Escondidos, guardam o lugar, e o
         nome não pula ao passar o mouse -->
    <Style Selector="Button.acao">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Button.acao">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:selected Button.acao">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.estrela">
      <Setter Property="Width" Value="20" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <!-- a cheia fica sempre à vista, em qualquer grupo, e na cor do grupo Favoritos, também
         com o mouse em cima. Vem depois do Button.acao para valer sobre ele -->
    <Style Selector="Button.estrela.favorito">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Yellow}" />
    </Style>
    <Style Selector="Button.estrela.favorito:pointerover /template/ ContentPresenter">
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource Yellow}" />
    </Style>

    <!-- os botões do canto, em pílula como as abas: aceso enquanto o que ele abre está
         aberto. O TextBlock tem cor própria no tema, por isso a cor vai nele -->
    <Style Selector="Button.pilula">
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,0,11,0" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.pilula TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pilula:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="Button.pilula.ligado">
      <Setter Property="Background" Value="{DynamicResource BgActive}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextFaint}" />
    </Style>
    <Style Selector="Button.pilula.ligado:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BgActive}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextDim}" />
    </Style>
    <Style Selector="Button.pilula.ligado TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>

    <!-- pílula colorida, como as do GTest (Abrir registro, Evidências): a cor do texto, o
         fundo diluído e o contorno vêm no próprio botão; com o mouse em cima o fundo pega o
         tom do contorno, e o texto continua na cor -->
    <Style Selector="Button.colorida">
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,0,11,0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.colorida:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{Binding $parent[Button].BorderBrush}" />
      <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
    </Style>
    <Style Selector="Button.colorida TextBlock">
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- só o ícone, numa bolinha do tamanho da altura -->
    <Style Selector="Button.colorida.redonda">
      <Setter Property="Width" Value="24" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Projetos e Sessões são uma escolha, como as abas: a escolhida é a pílula colorida
         inteira; a outra fica com o ícone na cor e o nome apagado, e acende com o mouse em
         cima. O glifo vem por último para ficar na cor também com o mouse em cima -->
    <Style Selector="Button.colorida.apagada /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    </Style>
    <Style Selector="Button.colorida.apagada:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
      <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
    </Style>
    <Style Selector="Button.colorida.apagada TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    </Style>
    <Style Selector="Button.colorida.apagada:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="Button.colorida.apagada TextBlock.glifo">
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>

    <!-- o glifo é do mesmo tamanho em todas as pílulas e no botão principal -->
    <Style Selector="Button TextBlock.glifo">
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- o botão principal (retomar) também é pílula, só que cheio e um pouco mais alto -->
    <Style Selector="Button.primary">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16,0,18,0" />
    </Style>

    <!-- a engrenagem das preferências, no rodapé: no azul do ícone, também com o mouse em cima -->
    <Style Selector="Button.config">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="Margin" Value="2,0,0,0" />
    </Style>
    <Style Selector="Button.config:pointerover /template/ ContentPresenter">
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="TextBlock.glifo">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons,Segoe MDL2 Assets" />
    </Style>

    <!-- os glifos do cia: da Nerd Font do terminal -->
    <Style Selector="TextBlock.nerd">
      <Setter Property="FontFamily" Value="CaskaydiaCove NFM,CaskaydiaMono Nerd Font,JetBrainsMono NFM,Symbols Nerd Font Mono" />
    </Style>

    <!-- o quadro do projeto parado, com o que o dashboard do cia mostra ao lado da lista:
         uma linha por item, o glifo na frente e, embaixo, o detalhe apagado -->
    <Style Selector="Border.quadro">
      <Setter Property="Background" Value="{DynamicResource BgRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Border.quadro TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.quadro TextBlock.detalhe">
      <Setter Property="Margin" Value="22,0,0,0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    </Style>
  </Window.Styles>

  <!-- a faixa de cima é a das abas; embaixo dela começam a árvore e o terminal, e a
       pesquisa fica na mesma altura do cartão do terminal -->
  <Grid ColumnDefinitions="240,*" RowDefinitions="Auto,*">

    <!-- na faixa das abas, em cima da árvore: os projetos do cia ou as conversas do Claude
         (o cl), e no modo das conversas o Claude sem nenhuma delas, no azul do Claude sem
         conversa do quadro -->
    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="10,6,8,6" Spacing="6">
      <Button Classes="colorida" Classes.apagada="{Binding ModoSessoes}" Command="{Binding VerProjetosCommand}"
              Foreground="{DynamicResource Orange}" Background="#24E07B00" BorderBrush="#66E07B00"
              ToolTip.Tip="Os projetos das pastas do cia, como no dashboard dele">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="glifo" Text="&#xE8B7;" />
          <TextBlock Text="Projetos" />
        </StackPanel>
      </Button>
      <Button Classes="colorida" Classes.apagada="{Binding !ModoSessoes}" Command="{Binding VerSessoesCommand}"
              Foreground="{DynamicResource Purple}" Background="#248B5CF6" BorderBrush="#668B5CF6"
              ToolTip.Tip="As conversas do Claude de todas as pastas, como o cl: retomar, favoritar e procurar pelo título">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="glifo" Text="&#xE8BD;" />
          <TextBlock Text="Sessões" />
        </StackPanel>
      </Button>
      <Button Classes="colorida redonda" Command="{Binding NovaConversaCommand}" IsVisible="{Binding ModoSessoes}"
              Foreground="{DynamicResource Accent}" Background="#242F7BE8" BorderBrush="#662F7BE8"
              ToolTip.Tip="Claude sem nenhuma das conversas: limpo, sem skill, na sua pasta pessoal, numa aba Claude">
        <TextBlock Classes="glifo" Text="&#xE710;" HorizontalAlignment="Center" />
      </Button>
    </StackPanel>

    <!-- árvore dos projetos do cia, sem botão de fechar. Encerrar só pelo menu de contexto,
         e sempre com confirmação. O menu de cada linha é montado na hora do clique direito
         (MainWindow.MenuDe): o "Mover para" depende dos grupos daquele momento -->
    <Border Grid.Row="1" Grid.Column="0">
      <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10,0,8,4">
          <TextBox x:Name="CaixaDoFiltro" Text="{Binding Filtro}" Watermark="{Binding MarcaDoFiltro}"
                   ToolTip.Tip="Filtra a lista (Ctrl+Shift+P): os projetos pelo nome, as conversas pelo título ou pelo projeto. Enter vai ao primeiro, Esc limpa" />
          <Button Grid.Column="1" Classes="colorida redonda" Margin="6,0,0,0" Command="{Binding NovoGrupoCommand}"
                  Foreground="{DynamicResource Yellow}" Background="#24B08500" BorderBrush="#66B08500"
                  ToolTip.Tip="Novo grupo. Clique direito num grupo cria um subgrupo, e arrastar leva projetos e conversas para ele">
            <TextBlock Classes="glifo" Text="&#xE8F4;" HorizontalAlignment="Center" />
          </Button>
        </Grid>

        <ListBox Grid.Row="1" x:Name="Lista" ItemsSource="{Binding Linhas}"
                 SelectedItem="{Binding LinhaSelecionada}">
          <ListBox.DataTemplates>
            <!-- grupo minimalista, como no GTest: seta, ponto cheio e o nome na cor dele -->
            <DataTemplate DataType="vm:GrupoDaArvore">
              <Button Classes="grupo" Classes.alvo="{Binding AlvoDeSoltar}" Command="{Binding AlternarCommand}">
                <Grid ColumnDefinitions="12,Auto,*,Auto" Margin="{Binding Recuo}">
                  <TextBlock Grid.Column="0" Text="{Binding Seta}" Classes="glifo faint" FontSize="8"
                             VerticalAlignment="Center" />
                  <Ellipse Grid.Column="1" Width="8" Height="8" Margin="2,0,0,0" VerticalAlignment="Center"
                           Fill="{Binding Cor}" />
                  <TextBlock Grid.Column="2" Text="{Binding Titulo}" FontSize="12" FontWeight="SemiBold" Margin="8,0"
                             Foreground="{Binding Cor}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding Contagem}" FontSize="11" Classes="faint"
                             VerticalAlignment="Center" />
                </Grid>
              </Button>
            </DataTemplate>

            <DataTemplate DataType="vm:LinhaDoProjeto">
              <Border Classes="linha" Classes.antes="{Binding SoltarAntes}" Classes.depois="{Binding SoltarDepois}"
                      ToolTip.Tip="{Binding Projeto.Pasta}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="{Binding Recuo}">
                  <!-- o tipo do projeto, como no cia: os glifos são da Nerd Font do terminal -->
                  <TextBlock Grid.Column="0" Classes="nerd" Text="{Binding Projeto.Icone}" Foreground="{Binding Projeto.CorDoIcone}"
                             FontSize="13" Width="16" Margin="0,0,7,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Projeto.Nome}" VerticalAlignment="Center" Margin="0,0,6,0"
                             Classes.atencao="{Binding Projeto.PedeAtencao}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Extra}" IsVisible="{Binding TemExtra}" Classes="faint"
                             FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0" />

                  <!-- favoritar sem abrir o menu: o projeto entra no fim dos favoritos, ou sai.
                       Lá, arrastar a linha muda a ordem -->
                  <Button Grid.Column="3" Classes="tiny simbolo acao estrela" Classes.favorito="{Binding Projeto.Favorito}"
                          Content="{Binding Projeto.GlifoDoFavorito}" Command="{Binding Projeto.FavoritarCommand}"
                          ToolTip.Tip="{Binding Projeto.RotuloDoFavorito}" />

                  <!-- sem terminal: nada roda no projeto até o clique aqui (ou Enter, ou duplo clique) -->
                  <Button Grid.Column="4" Classes="tiny simbolo acao" Content="&#xE768;" Margin="0,0,2,0"
                          Command="{Binding Projeto.IniciarCommand}" IsVisible="{Binding Projeto.Parado}"
                          ToolTip.Tip="Abrir o Claude neste projeto" />

                  <!-- apagado no prompt; amarelo rodando (piscando se espera por você); verde
                       ao terminar bem; vermelho ao terminar com erro -->
                  <Ellipse Grid.Column="5" Classes="estado" IsVisible="{Binding Projeto.Vivo}"
                           Classes.rodando="{Binding Projeto.Rodando}" Classes.aguardando="{Binding Projeto.Aguardando}"
                           Classes.concluido="{Binding Projeto.Concluido}" Classes.erro="{Binding Projeto.Erro}" />
                </Grid>
              </Border>
            </DataTemplate>

            <!-- uma conversa do Claude, como uma linha do cl: o título, e embaixo o projeto e
                 quando. A estrela e o ▶ como nos projetos; o ponto azul é a conversa aberta -->
            <DataTemplate DataType="vm:LinhaDaSessao">
              <Border Classes="linha sessao" Classes.antes="{Binding SoltarAntes}" Classes.depois="{Binding SoltarDepois}"
                      ToolTip.Tip="{Binding Dica}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="{Binding Recuo}">
                  <TextBlock Grid.Column="0" Classes="nerd" Text="{Binding Icone}" Foreground="{Binding CorDoIcone}"
                             FontSize="13" Width="16" Margin="0,0,7,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="0,0,6,0">
                    <TextBlock Text="{Binding Titulo}" FontSize="12" />
                    <TextBlock Text="{Binding Detalhe}" Classes="faint" FontSize="10.5" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="tiny simbolo acao estrela" Classes.favorito="{Binding Favorita}"
                          Content="{Binding GlifoDaEstrela}" Command="{Binding FavoritarCommand}"
                          ToolTip.Tip="{Binding RotuloDaEstrela}" />
                  <Button Grid.Column="3" Classes="tiny simbolo acao" Content="&#xE768;" Margin="0,0,2,0"
                          Command="{Binding RetomarCommand}" ToolTip.Tip="{Binding RotuloDeRetomar}" />
                  <Ellipse Grid.Column="4" Classes="estado aberta" IsVisible="{Binding Aberta}"
                           ToolTip.Tip="{Binding TextoDaAbertura}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>

        <!-- a versão em uso, que vira o convite quando há uma mais nova (clicar procura ou
             instala), e ao lado dela as preferências, no azul do ícone do app -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="6,2,6,7">
          <Button Classes="tiny rodape" Classes.destaque="{Binding TemAtualizacao}"
                  Content="{Binding Rodape}" Command="{Binding AtualizacaoCommand}" MaxWidth="200"
                  ToolTip.Tip="Procurar atualização" />
          <Button Classes="tiny simbolo config" Content="&#xE713;" Command="{Binding AbrirPreferenciasCommand}"
                  ToolTip.Tip="Preferências: fonte e tamanho do terminal, contas do Claude" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- uma aba por projeto com o Claude aberto, na ordem em que foram abertos (Ctrl+Tab
         passa por elas). Sem botão de fechar: encerrar só pela barra embaixo, e com
         confirmação -->
    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto,Auto" Margin="0,6,10,6" MinHeight="24">
      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="Abas" ItemsSource="{Binding Abertos}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="aba" Command="{Binding MostrarCommand}" ToolTip.Tip="{Binding Pasta}">
                <Border CornerRadius="12" Height="24" Padding="10,0" BorderThickness="1"
                        Background="{Binding FundoDaAba}" BorderBrush="{Binding BordaDaAba}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="8" Height="8" Fill="{Binding Cor}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Nome}" FontSize="12" VerticalAlignment="Center" Classes="aba"
                               Classes.frente="{Binding AVista}" Classes.atencao="{Binding PedeAtencao}" />
                    <!-- o estado do Claude, como na árvore -->
                    <Ellipse Classes="estado" Margin="1,0,0,0" IsVisible="{Binding Vivo}"
                             Classes.rodando="{Binding Rodando}" Classes.aguardando="{Binding Aguardando}"
                             Classes.concluido="{Binding Concluido}" Classes.erro="{Binding Erro}" />
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Button Grid.Column="1" Classes="pilula" Classes.ligado="{Binding PainelVisivel}"
              Command="{Binding AlternarPainelCommand}" IsVisible="{Binding TemPainel}"
              ToolTip.Tip="Abre ou fecha o painel lateral deste projeto">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="glifo" Text="&#xE90C;" />
          <TextBlock Text="Painel" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Classes="pilula" Classes.ligado="{Binding AuxiliarVisivel}"
              Command="{Binding AlternarAuxiliarCommand}" IsVisible="{Binding PodeAuxiliar}"
              ToolTip.Tip="Abre ou fecha um segundo terminal na pasta do projeto, para rodar comandos sem interromper o Claude">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="glifo" Text="&#xE756;" />
          <TextBlock Text="Terminal" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*">

      <!-- os botões da aba da frente, no tom dela: trocar de aba troca os botões. São as
           pílulas do projeto parado, com as mesmas cores. Quem encerra o Claude manda o
           /exit antes, e tudo que o encerra confirma. Com as pílulas de 24, a barra fica com
           os 28 da pesquisa ao lado -->
      <Border Grid.Row="0" x:Name="BarraDaAba" IsVisible="{Binding TemAbaAtiva}" Margin="0,0,8,6">
        <Border DataContext="{Binding AbaAtiva}" CornerRadius="14" Padding="1" BorderThickness="1"
                Background="{Binding FundoDaBarra}" BorderBrush="{Binding BordaDaBarra}">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Classes="colorida" Command="{Binding AbrirClaudeCommand}"
                      Foreground="{DynamicResource Green}" Background="#241F9D55" BorderBrush="#661F9D55"
                      ToolTip.Tip="Abre de novo retomando a última sessão, com /compact se ela estiver grande, como o cia">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="glifo" Text="&#xE768;" />
                  <TextBlock Text="Retomar" />
                </StackPanel>
              </Button>
              <Button Classes="colorida" Command="{Binding SessaoNovaCommand}"
                      Foreground="{DynamicResource Accent}" Background="#242F7BE8" BorderBrush="#662F7BE8"
                      ToolTip.Tip="Começa do zero, sem retomar a última sessão">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="glifo" Text="&#xE710;" />
                  <TextBlock Text="Sessão nova" />
                </StackPanel>
              </Button>
              <Button Classes="colorida" Command="{Binding PedidoCommand}" IsVisible="{Binding EhDaBmsoft}"
                      Foreground="{DynamicResource Yellow}" Background="#24B08500" BorderBrush="#66B08500"
                      ToolTip.Tip="Sessão nova no /pedido com o número do Mantis">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="glifo" Text="&#xE8A5;" />
                  <TextBlock Text="Pedido…" />
                </StackPanel>
              </Button>
              <Button Classes="colorida" Command="{Binding PullRequestCommand}" IsVisible="{Binding EhDaBmsoft}"
                      Foreground="{DynamicResource Purple}" Background="#248B5CF6" BorderBrush="#668B5CF6"
                      ToolTip.Tip="Sessão nova na /delphi-pr">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="glifo" Text="&#xE8AB;" />
                  <TextBlock Text="Pull request" />
                </StackPanel>
              </Button>
              <Button Classes="colorida" Command="{Binding SemSkillCommand}"
                      Foreground="{DynamicResource TextDim}" Background="#246B7280" BorderBrush="#666B7280"
                      ToolTip.Tip="O Claude limpo, sem skill nenhuma">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="glifo" Text="&#xE894;" />
                  <TextBlock Text="Sem skill" />
                </StackPanel>
              </Button>
              <Rectangle Width="1" Height="12" Margin="2,0" Fill="{DynamicResource Border}" VerticalAlignment="Center" />

              <!-- a paleta do GRepos abre aqui, montada no código da janela -->
              <Button Classes="colorida" x:Name="CorDaAba" ToolTip.Tip="A cor da aba deste projeto"
                      Foreground="{DynamicResource TextDim}" Background="#246B7280" BorderBrush="#666B7280">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="8" Height="8" Fill="{Binding Cor}" VerticalAlignment="Center" />
                  <TextBlock Text="Cor" />
                </StackPanel>
              </Button>
            </StackPanel>

            <Button Grid.Column="1" Classes="colorida" Command="{Binding EncerrarCommand}"
                    Foreground="{DynamicResource Red}" Background="#24D93F3F" BorderBrush="#66D93F3F"
                    ToolTip.Tip="Manda o /exit ao Claude e fecha a aba; o que estiver rodando é interrompido">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="glifo" Text="&#xE7E8;" />
                <TextBlock Text="Encerrar o Claude" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
      </Border>

      <!-- o terminal encaixado num cartão: a janela em volta é a moldura, no tom da
           árvore. O recorte arredonda também o conteúdo do terminal -->
      <Border Grid.Row="1" x:Name="Cartao" Margin="0,0,8,8" CornerRadius="10" ClipToBounds="True"
              Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">

        <!-- um terminal por projeto aberto, todos vivos; só o do selecionado aparece -->
        <ItemsControl Grid.Column="0" x:Name="Sessoes" ItemsSource="{Binding Sessoes}" Margin="10,7,3,8">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Grid />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <term:TerminalControl Model="{Binding Modelo}" IsVisible="{Binding Ativa}"
                                    RightClickAction="CopyOrPaste" CaretStyle="Bar"
                                    DefaultBackground="{DynamicResource Bg}" CaretBrush="{DynamicResource Text}"
                                    FontFamily="{Binding $parent[ItemsControl].DataContext.Fonte}"
                                    FontSize="{Binding $parent[ItemsControl].DataContext.TamanhoDaFonte}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- segundo terminal do projeto, embaixo do principal: um shell simples, para o
             build ou o git que não podem esperar o Claude terminar -->
        <Border Grid.Row="1" Grid.Column="0" Height="230" IsVisible="{Binding AuxiliarVisivel}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
          <ItemsControl x:Name="Auxiliares" ItemsSource="{Binding Auxiliares}" Margin="10,7,3,8">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Grid />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <term:TerminalControl Model="{Binding Modelo}" IsVisible="{Binding Ativa}"
                                      RightClickAction="CopyOrPaste" CaretStyle="Bar"
                                      DefaultBackground="{DynamicResource Bg}" CaretBrush="{DynamicResource Text}"
                                      FontFamily="{Binding $parent[ItemsControl].DataContext.Fonte}"
                                      FontSize="{Binding $parent[ItemsControl].DataContext.TamanhoDaFonte}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- painel lateral (o consumo do Claude, por exemplo): outro terminal, estreito,
             rodando o script das preferências na pasta e na conta do projeto -->
        <Border Grid.Column="1" Grid.RowSpan="2" Width="330" IsVisible="{Binding PainelVisivel}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
          <ItemsControl x:Name="Paineis" ItemsSource="{Binding Paineis}" Margin="8,7,3,8">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Grid />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <term:TerminalControl Model="{Binding Modelo}" IsVisible="{Binding Ativa}"
                                      RightClickAction="CopyOrPaste" CaretStyle="Bar"
                                      DefaultBackground="{DynamicResource Bg}" CaretBrush="{DynamicResource Bg}"
                                      FontFamily="{Binding $parent[ItemsControl].DataContext.Fonte}"
                                      FontSize="{Binding $parent[ItemsControl].DataContext.TamanhoDaFonte}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- sem terminal à vista: o aviso (nenhum projeto, nenhum escolhido, erro ao abrir)
             e, no projeto parado, os jeitos de abrir o Claude pelo cia -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    MaxWidth="520" Margin="16,0">
          <TextBlock Text="{Binding Aviso}" Classes="dim" TextWrapping="Wrap" TextAlignment="Center"
                     IsVisible="{Binding Aviso, Converter={x:Static ObjectConverters.IsNotNull}}" />

          <StackPanel Spacing="10" IsVisible="{Binding MostrarParado}">
            <!-- sem aba ainda: o nome, a pasta e o tipo ficam aqui -->
            <StackPanel Spacing="2" Margin="0,0,0,4">
              <TextBlock Text="{Binding Selecionado.Nome}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <TextBlock Text="{Binding Selecionado.Pasta}" Classes="faint" FontSize="11" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Classes="nerd" Text="{Binding Selecionado.Icone}" Foreground="{Binding Selecionado.CorDoIcone}"
                             FontSize="11" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Selecionado.Tipo}" Foreground="{Binding Selecionado.CorDoIcone}" FontSize="11" />
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- o quadro do cia: o git, o CLAUDE.md, a sessão que o Enter retoma e a última
                 vez que o projeto foi aberto -->
            <Border Classes="quadro" MinWidth="360" MaxWidth="460" Margin="0,0,0,6">
              <StackPanel Spacing="4">
                <TextBlock Text="carregando…" Classes="faint" IsVisible="{Binding !Selecionado.GitLido}" />

                <Grid ColumnDefinitions="22,*" IsVisible="{Binding Selecionado.SemGit}">
                  <TextBlock Classes="nerd faint" Text="&#xE725;" />
                  <TextBlock Grid.Column="1" Classes="faint" Text="sem git" />
                </Grid>

                <StackPanel Spacing="1" IsVisible="{Binding Selecionado.GitRecusou}">
                  <Grid ColumnDefinitions="22,*">
                    <TextBlock Text="!" FontWeight="Bold" Foreground="{DynamicResource Yellow}" />
                    <TextBlock Grid.Column="1" Text="o git recusou o repositório" Foreground="{DynamicResource Yellow}" />
                  </Grid>
                  <TextBlock Classes="detalhe" Text="provável dubious ownership (safe.directory)" />
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding Selecionado.ComGit}">
                  <Grid ColumnDefinitions="22,Auto,*">
                    <TextBlock Classes="nerd" Text="&#xE725;" Foreground="{DynamicResource Purple}" />
                    <TextBlock Grid.Column="1" Text="{Binding Selecionado.Git.Branch}" />
                    <TextBlock Grid.Column="2" Text="{Binding Selecionado.AFrenteAtras}" Margin="10,0,0,0"
                               Foreground="{DynamicResource Accent}" />
                  </Grid>
                  <Grid ColumnDefinitions="22,*" IsVisible="{Binding Selecionado.Limpo}">
                    <TextBlock Classes="nerd" Text="&#xF00C;" Foreground="{DynamicResource Green}" />
                    <TextBlock Grid.Column="1" Text="limpo" Foreground="{DynamicResource Green}" />
                  </Grid>
                  <Grid ColumnDefinitions="22,*" IsVisible="{Binding Selecionado.Alterado}">
                    <TextBlock Text="●" Foreground="{DynamicResource Yellow}" />
                    <TextBlock Grid.Column="1" Text="{Binding Selecionado.TextoDasAlteracoes}"
                               Foreground="{DynamicResource Yellow}" />
                  </Grid>
                  <StackPanel Spacing="1" IsVisible="{Binding Selecionado.TemCommit}">
                    <Grid ColumnDefinitions="22,*">
                      <TextBlock Classes="nerd faint" Text="&#xE729;" />
                      <TextBlock Grid.Column="1" Text="{Binding Selecionado.TextoDoCommit}" />
                    </Grid>
                    <TextBlock Classes="detalhe" Text="{Binding Selecionado.Git.Mensagem}" />
                  </StackPanel>
                </StackPanel>

                <Grid ColumnDefinitions="22,Auto,*">
                  <TextBlock Classes="nerd faint" Text="&#xF15B;" />
                  <TextBlock Grid.Column="1" Text="CLAUDE.md" Margin="0,0,6,0" />
                  <TextBlock Grid.Column="2" Text="sim" Foreground="{DynamicResource Green}"
                             IsVisible="{Binding Selecionado.TemClaudeMd}" />
                  <TextBlock Grid.Column="2" Text="não" Classes="faint" IsVisible="{Binding !Selecionado.TemClaudeMd}" />
                </Grid>

                <StackPanel Spacing="1" IsVisible="{Binding Selecionado.TemSessao}">
                  <Grid ColumnDefinitions="22,Auto,*">
                    <TextBlock Classes="nerd" Text="&#xF120;" Foreground="{DynamicResource Accent}" />
                    <TextBlock Grid.Column="1" Text="{Binding Selecionado.QuandoDaSessao}" />
                    <TextBlock Grid.Column="2" Text="{Binding Selecionado.TamanhoDaSessao}" Classes="faint" Margin="10,0,0,0" />
                  </Grid>
                  <TextBlock Classes="detalhe" Text="{Binding Selecionado.UltimaSessao.Titulo}" />
                </StackPanel>

                <Grid ColumnDefinitions="22,Auto,*" IsVisible="{Binding Selecionado.TemAbertura}">
                  <TextBlock Classes="nerd faint" Text="&#xF017;" />
                  <TextBlock Grid.Column="1" Text="{Binding Selecionado.TextoDaAbertura}" />
                  <TextBlock Grid.Column="2" Text="{Binding Selecionado.DetalheDaAbertura}" Classes="faint" />
                </Grid>
              </StackPanel>
            </Border>

            <Button Classes="primary" HorizontalAlignment="Center"
                    Command="{Binding Selecionado.IniciarCommand}"
                    ToolTip.Tip="Retoma a última sessão do projeto, com /compact se ela estiver grande, como o cia">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="glifo" Text="&#xE768;" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Selecionado.RotuloDeAbrir}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Text="{Binding Selecionado.TextoDaSessao}" Classes="faint" FontSize="11.5"
                       IsVisible="{Binding Selecionado.TemTextoDaSessao}"
                       TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            <!-- os outros jeitos de abrir, em pílula colorida como as do GTest: fundo diluído
                 e contorno na cor de cada um -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
              <Button Classes="colorida" Command="{Binding Selecionado.SessaoNovaCommand}"
                      Foreground="{DynamicResource Accent}" Background="#242F7BE8" BorderBrush="#662F7BE8"
                      ToolTip.Tip="Começa do zero, sem retomar a última sessão">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="glifo" Text="&#xE710;" />
                  <TextBlock Text="Sessão nova" />
                </StackPanel>
              </Button>
              <Button Classes="colorida" Command="{Binding Selecionado.PedidoCommand}"
                      IsVisible="{Binding Selecionado.EhDaBmsoft}"
                      Foreground="{DynamicResource Yellow}" Background="#24B08500" BorderBrush="#66B08500"
                      ToolTip.Tip="Sessão nova no /pedido com o número do Mantis">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="glifo" Text="&#xE8A5;" />
                  <TextBlock Text="Pedido…" />
                </StackPanel>
              </Button>
              <Button Classes="colorida" Command="{Binding Selecionado.PullRequestCommand}"
                      IsVisible="{Binding Selecionado.EhDaBmsoft}"
                      Foreground="{DynamicResource Purple}" Background="#248B5CF6" BorderBrush="#668B5CF6"
                      ToolTip.Tip="Sessão nova na /delphi-pr">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="glifo" Text="&#xE8AB;" />
                  <TextBlock Text="Pull request" />
                </StackPanel>
              </Button>
              <Button Classes="colorida" Command="{Binding Selecionado.SemSkillCommand}"
                      Foreground="{DynamicResource TextDim}" Background="#246B7280" BorderBrush="#666B7280"
                      ToolTip.Tip="O Claude limpo, sem skill nenhuma">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="glifo" Text="&#xE894;" />
                  <TextBlock Text="Sem skill" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>

          <!-- a conversa escolhida no modo Sessões, no mesmo quadro do projeto parado: o que o
               cl mostra numa linha, e retomar ou favoritar -->
          <StackPanel Spacing="10" IsVisible="{Binding MostrarSessao}">
            <StackPanel Spacing="3" Margin="0,0,0,4">
              <TextBlock Text="{Binding SessaoAVista.Titulo}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                         TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Classes="nerd" Text="{Binding SessaoAVista.Icone}" Foreground="{Binding SessaoAVista.CorDoIcone}"
                             FontSize="11" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding SessaoAVista.Projeto}" Foreground="{Binding SessaoAVista.CorDoIcone}" FontSize="11" />
                </StackPanel>
                <TextBlock Text="{Binding SessaoAVista.Sessao.Pasta}" Classes="faint" FontSize="11" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>

            <Border Classes="quadro" MinWidth="360" MaxWidth="460" Margin="0,0,0,6">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="22,*" IsVisible="{Binding SessaoAVista.TemBranch}">
                  <TextBlock Classes="nerd" Text="&#xE725;" Foreground="{DynamicResource Purple}" />
                  <TextBlock Grid.Column="1" Text="{Binding SessaoAVista.Sessao.Branch}" />
                </Grid>
                <Grid ColumnDefinitions="22,Auto,*">
                  <TextBlock Classes="nerd" Text="&#xF120;" Foreground="{DynamicResource Accent}" />
                  <TextBlock Grid.Column="1" Text="{Binding SessaoAVista.Quando}" />
                  <TextBlock Grid.Column="2" Text="{Binding SessaoAVista.Tamanho}" Classes="faint" Margin="10,0,0,0" />
                </Grid>
                <Grid ColumnDefinitions="22,*" IsVisible="{Binding SessaoAVista.Aberta}">
                  <TextBlock Text="●" Foreground="{DynamicResource Accent}" />
                  <TextBlock Grid.Column="1" Text="{Binding SessaoAVista.TextoDaAbertura}" Foreground="{DynamicResource Accent}" />
                </Grid>
                <Grid ColumnDefinitions="22,*" IsVisible="{Binding SessaoAVista.Sessao.Bg}">
                  <TextBlock Classes="glifo" Text="&#xE823;" FontSize="11" Foreground="{DynamicResource Purple}" />
                  <TextBlock Grid.Column="1" Text="com um job em segundo plano" Foreground="{DynamicResource Purple}" />
                </Grid>
                <Grid ColumnDefinitions="22,*">
                  <TextBlock Classes="nerd faint" Text="&#xF292;" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding SessaoAVista.Sessao.Id}" Classes="faint" FontSize="11.5"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}" />
                </Grid>
              </StackPanel>
            </Border>

            <Button Classes="primary" HorizontalAlignment="Center"
                    Command="{Binding SessaoAVista.RetomarCommand}"
                    ToolTip.Tip="Abre o Claude na pasta da conversa, na aba do projeto, com o --resume dela, como o cl">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="glifo" Text="&#xE768;" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SessaoAVista.RotuloDeRetomar}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
              <Button Classes="colorida" Command="{Binding SessaoAVista.FavoritarCommand}"
                      Foreground="{DynamicResource Yellow}" Background="#24B08500" BorderBrush="#66B08500"
                      ToolTip.Tip="As favoritas ficam em cima, em qualquer pasta, e são as mesmas do cl">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="glifo" Text="{Binding SessaoAVista.GlifoDaEstrela}" />
                  <TextBlock Text="{Binding SessaoAVista.RotuloDaEstrela}" />
                </StackPanel>
              </Button>
              <Button Classes="colorida" Command="{Binding NovaConversaCommand}"
                      Foreground="{DynamicResource Accent}" Background="#242F7BE8" BorderBrush="#662F7BE8"
                      ToolTip.Tip="Claude sem nenhuma das conversas: limpo, sem skill, na sua pasta pessoal, numa aba Claude">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="glifo" Text="&#xE710;" />
                  <TextBlock Text="Claude sem conversa" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
